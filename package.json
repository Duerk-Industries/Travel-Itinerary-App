{
  "name": "shared-trip-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "app"
  ],
  "scripts": {
    "start": "node server/scripts/start-with-debug.js",
    "build": "npm --prefix server run build",
    "lint": "echo \"Add linters per workspace\"",
    "test": "npm run test:app && npm run test:server",
    "test:e2e": "npx playwright test",
    "emulators:container": "docker build -f functions/Dockerfile.local -t travel-itinerary-emulators . && docker run --rm -p 4001:4001 -p 5001:5001 -p 8080:8080 -p 9099:9099 -p 9199:9199 travel-itinerary-emulators",
    "postinstall": "patch-package",
    "playwright:install": "node ./node_modules/@playwright/test/cli.js install",
    "test:app": "npm --prefix app test",
    "test:server": "npm --prefix server test",
    "locations:upload": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/upload-location-csvs.ts",
    "images:migrate-cache": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/migrate-image-cache-to-storage.ts",
    "list-users": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/list_users.ts",
    "list-trips": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/list_trips_and_users.ts"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-test-renderer": "18.2.0"
  },
  "engines": {
    "node": ">=20.x"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/react-test-renderer": "^18.0.7",
    "patch-package": "^8.0.1",
    "react-native-dotenv": "^3.4.11",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "18.2.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "24": "^0.0.0",
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@types/react": "~18.2.45",
    "expo": "~50.0.20",
    "expo-web-browser": "~12.8.2",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.1",
    "firebase-tools": "^15.5.1",
    "outdated": "^0.1.1",
    "passport-google-oauth20": "^2.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-web": "~0.19.6",
    "update": "^0.7.4"
  }
}
