# Copy to scripts/deploy.config and fill in real values. scripts/deploy.config
# is intentionally git-ignored.

ARTIFACT_REGISTRY_REPO=us-east5-docker.pkg.dev/travel-itinerary-app-483623/cloud-run-source-deploy
#ARTIFACT_REGISTRY_REPO=us-east5-docker.pkg.dev/travel-itinerary-app-483623/travel-itinerary-app
ROLLBACK_RETENTION_DAYS=7

TEST_SERVICE_NAME=travel-itinerary-app-test-483623
TEST_REGION=us-east5
TEST_HOSTING_SITE=travel-itinerary-app-test
TEST_DOMAIN=https://test.duerk.org
TEST_FIRESTORE_DATABASE_ID=travel-itinerary-app-test-database
TEST_RUNTIME_SERVICE_ACCOUNT=travel-itinerary-app-test-sa@travel-itinerary-app-483623.iam.gserviceaccount.com
TEST_AI_CAPTURE_BUCKET=travel-itinerary-app-test-ai-captures

PROD_SERVICE_NAME=travel-itinerary-app
PROD_REGION=us-east5
PROD_HOSTING_SITE=travel-itinerary-app-483623
PROD_DOMAIN=https://wander-bunnies.com
PROD_FIRESTORE_DATABASE_ID=travel-itinerary-app-database
PROD_RUNTIME_SERVICE_ACCOUNT=travel-itinerary-app-sa@travel-itinerary-app-483623.iam.gserviceaccount.com
PROD_AI_CAPTURE_BUCKET=travel-itinerary-app-ai-captures

# Shared secret the deploy scripts send as `X-Deploy-Worker-Secret` when
# calling the server's internal-only /api/internal/deploy/* endpoints
# (canary smoke write/cleanup, durable audit_log writes). Must match the
# server's DEPLOY_WORKER_SHARED_SECRET env var. Required for canary
# write/cleanup and durable audit logging; scripts degrade to a warning and
# skip those steps if unset, rather than failing the whole deploy.
DEPLOY_WORKER_SHARED_SECRET=B3827A6A3B27AF488B9421B0993B4A094356B028EB17923F1F0E13631A124CF5

# Optional override for where the internal deploy API lives. Defaults to
# "$PROD_DOMAIN/api/internal/deploy" in every script that needs it.
# DEPLOY_AUDIT_API_URL=

# Email of the permanent internal canary account (Chapter 16 §6). Must match
# the server's CANARY_ACCOUNT_EMAIL env var so the server bootstraps the
# same account these scripts write against.
CANARY_ACCOUNT_EMAIL=canary@internal.wander-bunnies.com
