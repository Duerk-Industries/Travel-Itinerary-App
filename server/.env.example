# Core server settings
PORT=4000
AUTH_SECRET=change-me-to-a-long-random-string
BACKEND_URL=https://wander-bunnies.com

# OAuth redirect allow-list (comma- or semicolon-separated). Web origins (https://your.app,
# http://localhost:8081) plus native deep-link scheme prefixes. The native app's scheme is
# `travelitineraryplanner` (app/app.config.ts), so include `travelitineraryplanner://` or native
# Google sign-in is rejected with HTTP 400 before reaching Google. Add exp://<host>/--/ for Expo Go.
AUTH_REDIRECT_URI_ALLOWLIST=https://wander-bunnies.com;http://localhost:8081;travelitineraryplanner://
DB_PROVIDER=postgres # options: postgres | memory | dynamodb | firebase
USE_IN_MEMORY_DB=0   # set to 1 for Jest/pg-mem runs

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shared_trip_planner

# Firebase / Firestore (hosted or emulator)
# GCLOUD_PROJECT_ID is used for both hosted and emulator runs.
GCLOUD_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com # from service account JSON (client_email)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY----- # from service account JSON (private_key)
# To use the Firestore emulator, set FIRESTORE_EMULATOR_HOST=localhost:8080 (or your emulator host:port)

# Firebase emulator settings (optional; for local development with Firestore emulator)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=YOUR_PROJECT_ID

# DynamoDB (adapter scaffolding only)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1

# HTTPS (optional)
HTTPS_KEY_FILE=../../certs/duerkhome.asuscomm.com.key.pem
HTTPS_CERT_FILE=../../certs/duerkhome.asuscomm.com.cert.pem

# SMTP (optional; enables invite/share emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shared Trip Planner <noreply@example.com>"

# AI providers (optional; admin AI Operations only enables registered providers with keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# Local/default AI routing for itinerary generation. When no admin DB override
# exists, the server will use AI_ITINERARY_PROVIDER if set; otherwise it will
# pick the first configured provider whose API key is present.
# Options today: openai | anthropic | gemini | zai | openai_compatible
AI_ITINERARY_PROVIDER=openai
# Optional model override for the selected itinerary provider.
AI_ITINERARY_MODEL=gpt-4o-mini
# Same behavior for ingestion's LLM extraction fallback.
AI_INGESTION_LLM_PROVIDER=openai
AI_INGESTION_LLM_MODEL=gpt-4o-mini
# Optional model lists surfaced in Admin -> AI Operations. Comma-separated.
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
ANTHROPIC_MODELS=claude-sonnet-4-5,claude-3-7-sonnet-latest,claude-3-5-haiku-latest
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
ZAI_MODELS=glm-4.7,glm-4.5-air,glm-4.5
OPENAI_COMPATIBLE_MODELS=qwen2.5-coder-32b-instruct,meta-llama-3.1-8b-instruct,gpt-4o-mini
# Defaults to Z.ai's general OpenAI-compatible endpoint. Coding-plan accounts may need:
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Generic localhost or third-party OpenAI-compatible backend. Example:
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# Keep false to prefer cached/local attractions catalog and reduce live discovery calls.
ITINERARY_ATTRACTIONS_DISCOVERY_ENABLED=false

# API usage limits are loaded from YAML:
#   server/config/api-limits.yaml
# Optional override path:
# API_LIMITS_CONFIG_PATH=server/config/api-limits.yaml

# Cache timeout settings (minutes)
UNSPLASH_IMAGE_CACHE_TIMEOUT_MINUTES=525600
SIGNED_IMAGE_URL_CACHE_TIMEOUT_MINUTES=15
GOOGLE_PLACES_DETAILS_CACHE_TIMEOUT_MINUTES=1440
STORAGE_IMAGE_CACHE_CONTROL_TIMEOUT_MINUTES=1440
UNSPLASH_AUTH_BLOCK_CACHE_TIMEOUT_MINUTES=10
SESSION_CACHE_TIMEOUT_MINUTES=720

# Email ingestion (optional)
# Defaults to travel.docs@wander-bunnies.com when unset.
INGESTION_FORWARDING_ADDRESS=travel.docs@wander-bunnies.com
# Shared secret required when INGESTION_JOB_QUEUE_MODE is not in_process
# (i.e. ingestion jobs run via HTTP callback to a Cloud Run worker instead of
# in the same process). Generate with: openssl rand -hex 32
# Set the same value as the worker's X-Ingestion-Worker-Secret expectation.
INGESTION_WORKER_SHARED_SECRET=
# Base URL the job queue calls back to when INGESTION_JOB_QUEUE_MODE=cloud.
# Defaults to BACKEND_URL when unset; only needed if the worker is a
# separate deployment from the main API.
INGESTION_WORKER_BASE_URL=
# GCS bucket AI interaction captures (Chapter 12 / itinerary generation +
# mail parsing capture-and-evaluate framework) are written to. Required for
# capture to persist beyond local disk.
AI_CAPTURE_BUCKET=

# Stripe Billing (optional; enables Premium subscriptions)
# Set STRIPE_BILLING_ENABLED=true and supply all keys below to activate.
# Use test keys locally (sk_test_... or rk_test_...) and restricted live keys in production (rk_live_... preferred over sk_live_...).
# Never commit live keys to source control.
STRIPE_BILLING_ENABLED=false
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRODUCT_ID=prod_...
# Optional: only needed when using an API-created Customer Portal configuration
# STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=bpc_...
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:19006/?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:19006/?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:19006/
STRIPE_REQUIRE_TAX_CONFIGURATION=false
# Set true after Stripe Tax origin address, tax code, and required registrations are configured in Stripe Dashboard.
STRIPE_TAX_CONFIGURED=false
# Price IDs from Stripe Dashboard (test: price_test_..., live: price_live_...)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_...
BILLING_RECONCILE_ENABLED=true
BILLING_RECONCILE_INTERVAL_MS=86400000
# Shared secret for POST /api/internal/billing/reconcile (called by Cloud Scheduler).
# Generate with: openssl rand -hex 32
# Set this same value in the Cloud Scheduler job's X-Billing-Scheduler-Secret header.
# In production, store in Secret Manager and reference via _FILE suffix or deploy script.
BILLING_SCHEDULER_SECRET=

# Phase 11 deployment path (scripts/deploy-test.sh|.ps1, deploy-prod, cutover-test-to-prod,
# rollback, teardown-old-production — see docs/production-deployment-guide.md).
# Permanent internal canary account email (Chapter 16 §6). The server
# bootstraps this account automatically on startup and marks it
# is_internal_canary: true. Must match scripts/deploy.config's
# CANARY_ACCOUNT_EMAIL so cutover's smoke write/cleanup targets the same
# account the server enforces email/Stripe suppression for.
CANARY_ACCOUNT_EMAIL=
# Shared secret required by POST /api/internal/deploy/* (canary smoke
# write/cleanup, durable audit_log writes called by the deploy scripts).
# Generate with: openssl rand -hex 32
# Must match scripts/deploy.config's DEPLOY_WORKER_SHARED_SECRET and the
# GitHub Actions secret of the same name.
DEPLOY_WORKER_SHARED_SECRET=
