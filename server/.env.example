# Core server settings
PORT=4000
AUTH_SECRET=change-me-to-a-long-random-string
DB_PROVIDER=postgres # options: postgres | memory | dynamodb | firebase
USE_IN_MEMORY_DB=0   # set to 1 for Jest/pg-mem runs

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shared_trip_planner

# Firebase / Firestore (hosted or emulator)
# GCLOUD_PROJECT_ID is used for both hosted and emulator runs.
GCLOUD_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com # from service account JSON (client_email)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY----- # from service account JSON (private_key)
# To use the Firestore emulator, set FIRESTORE_EMULATOR_HOST=localhost:8080 (or your emulator host:port)

# Firebase emulator settings (optional; for local development with Firestore emulator)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=YOUR_PROJECT_ID

# DynamoDB (adapter scaffolding only)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1

# HTTPS (optional)
HTTPS_KEY_FILE=../../certs/duerkhome.asuscomm.com.key.pem
HTTPS_CERT_FILE=../../certs/duerkhome.asuscomm.com.cert.pem

# SMTP (optional; enables invite/share emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shared Trip Planner <noreply@example.com>"

# OpenAI (used for itinerary routes, optional)
OPENAI_API_KEY=
# Keep false to prefer cached/local attractions catalog and reduce live discovery calls.
ITINERARY_ATTRACTIONS_DISCOVERY_ENABLED=false

# API usage limits are loaded from YAML:
#   server/config/api-limits.yaml
# Optional override path:
# API_LIMITS_CONFIG_PATH=server/config/api-limits.yaml

# Cache timeout settings (minutes)
UNSPLASH_IMAGE_CACHE_TIMEOUT_MINUTES=525600
SIGNED_IMAGE_URL_CACHE_TIMEOUT_MINUTES=15
GOOGLE_PLACES_DETAILS_CACHE_TIMEOUT_MINUTES=1440
STORAGE_IMAGE_CACHE_CONTROL_TIMEOUT_MINUTES=1440
UNSPLASH_AUTH_BLOCK_CACHE_TIMEOUT_MINUTES=10
SESSION_CACHE_TIMEOUT_MINUTES=720
