{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p . && node ./scripts/copy-runtime-assets.js",
    "predev": "tsx ../scripts/seed-dev-accounts.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "npm run typecheck",
    "migrate": "tsx scripts/migrate.ts",
    "cost-model": "tsx scripts/cost-model.ts",
    "replay:itinerary": "tsx scripts/replay-itinerary-generation.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.projects.js",
    "test:single": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.projects.js",
    "test:shard": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.projects.js --runInBand",
    "test:sharded": "node ../scripts/run-jest-shards.mjs --prefix . --script test:single --shards 12 -- --runInBand",
    "typecheck": "tsc --noEmit -p ."
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "js-yaml": "4.2.0",
    "@google-cloud/storage": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "@sentry/node": "^10.58.0",
    "@types/multer": "^2.1.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.13.5",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "docling-sdk": "^2.0.4",
    "dotenv": "^16.4.5",
    "exponential-backoff": "^3.1.3",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.22.0",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0",
    "tesseract.js": "^5.1.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.5",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^2.0.16",
    "jest": "^30.2.0",
    "pg-mem": "^3.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
