    "places": {
      "guatemala/antigua-colonial": {
        "name": "Antigua colonial centre",
        "description": "A UNESCO colonial city of cobbled streets, ruined churches and volcano views.",
        "details": "Antigua has the Santa Catalina Arch, the Cerro de la Cruz viewpoint and many ruined baroque churches. The central plaza and the La Merced church are the heart. Markets, chocolate workshops and cafes fill the old streets. It is at 1,500 metres, so the climate is mild.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "guatemala/pacaya-volcano": {
        "name": "Pacaya Volcano hike",
        "description": "A half-day hike to lava fields and, when active, glowing lava, close to Antigua.",
        "details": "Pacaya is an active volcano reached by a 2-hour climb across black lava fields. Guides lead groups, and some days allow marshmallow roasting on warm rocks. Conditions depend on volcanic activity, so check the status. Dress in layers and wear sturdy shoes.",
        "interests": [
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "H",
        "image": null
      },
      "guatemala/acatenango": {
        "name": "Acatenango overnight volcano climb",
        "description": "An overnight trek to see the eruptions of neighbouring Fuego volcano.",
        "details": "Acatenango is a challenging overnight hike to a camp at about 3,600 metres in front of the active Fuego volcano, with the climb to the summit at dawn. It is cold and tiring. Go with a reputable operator, and check conditions.",
        "interests": [
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "H",
        "image": null
      },
      "guatemala/lake-atitlan": {
        "name": "Lake Atitlan villages by boat",
        "description": "A volcanic lake ringed by Maya villages, reached by shared boats.",
        "details": "Lake Atitlan is surrounded by three volcanoes. Boats link Panajachel with San Pedro, San Marcos, Santiago and others. San Juan has women weaving cooperatives, San Marcos has yoga and healing, and Santa Cruz has quiet hotels. Afternoon winds make the lake choppy, so travel in the morning.",
        "interests": [
          "relax",
          "culture",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "guatemala/indian-nose": {
        "name": "Indian Nose sunrise",
        "description": "A hill viewpoint above the lake for a sunrise over the volcanoes.",
        "details": "The Indian Nose is a short pre-dawn hike from San Juan or San Pedro, with an expansive view of Lake Atitlan and the volcanoes at sunrise. Take a headlamp and a warm layer. Clouds can hide the view, so go on a clear morning.",
        "interests": [
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "guatemala/chichicastenango": {
        "name": "Chichicastenango market",
        "description": "One of the largest indigenous markets in Central America, held on Thursday and Sunday.",
        "details": "Chichi market sprawls through the town with textiles, masks, produce and flowers, and the Santo Tomas church steps are used for Maya rituals with incense. Sunday and Thursday are market days. Bargain politely, and ask before photographing people.",
        "interests": [
          "culture",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "guatemala/semuc-champey": {
        "name": "Semuc Champey",
        "description": "Turquoise limestone pools stepping down a river, in the green hills of Alta Verapaz.",
        "details": "The Semuc Champey terraces are natural pools that can be swum, reached by a steep hike to the viewpoint. Cave tubing in K anba Cave and river tubing add adventure. The access road is long and rough from every direction. Visit early to avoid crowds.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "relax"
        ],
        "mobility": "M",
        "image": null
      },
      "guatemala/tikal": {
        "name": "Tikal National Park",
        "description": "A Maya city rising out of the rainforest, with temples taller than the canopy.",
        "details": "Tikal has towering pyramids, plazas and rainforest alive with howler monkeys and toucans. Temple IV is the classic sunrise point. A guide helps explain the layout. The site is hot and humid, so bring water and repellent. Sunrise tours need to be arranged in advance.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "guatemala/flores": {
        "name": "Flores island",
        "description": "A cobbled island town on Lake Peten Itza, a pleasant base for Tikal.",
        "details": "Flores is a small island linked to the shore by a causeway, with colourful houses and lakeside restaurants. Evening is for sunsets by the water. Boats and kayaks explore the lake, and cheap shared vans go to Tikal.",
