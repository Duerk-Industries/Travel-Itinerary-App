    "places": {
      "philippines/manila-intramuros": {
        "name": "Manila Intramuros and Fort Santiago",
        "description": "The walled Spanish colonial city, with churches, a fortress and horse-drawn calesas.",
        "details": "Intramuros is the walled old city of Manila, with San Agustin Church (a UNESCO site), Fort Santiago and the Casa Manila museum. A walking or calesa tour covers it in half a day. Manila traffic is heavy, so allow extra time for transfers.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "philippines/banaue-terraces": {
        "name": "Banaue and Batad rice terraces",
        "description": "Two-thousand-year-old rice terraces carved by hand into the Cordillera mountains.",
        "details": "The Banaue terraces are a UNESCO landscape, and the amphitheatre-shaped terraces at Batad are reached by a trek of about an hour from the road. Planting and harvest seasons colour the view. The overnight bus from Manila takes about nine hours.",
        "interests": [
          "outdoors",
          "photography",
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "H",
        "image": null
      },
      "philippines/coron-lagoons": {
        "name": "Coron island hopping and Kayangan Lake",
        "description": "Limestone islands, lagoons for swimming and a WWII wreck snorkel.",
        "details": "Coron boat tours visit Kayangan Lake, Twin Lagoon and Barracuda Lake, with snorkelling over sunken Japanese ships. The scenery is dramatic limestone cliffs rising from clear water. Tours run daily, and tickets include environmental fees.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "philippines/el-nido-bacuit": {
        "name": "El Nido island hopping in Bacuit Bay",
        "description": "Lagoons, hidden beaches and kayaking among limestone karsts.",
        "details": "El Nido tours are labelled A to D, covering the Big and Small Lagoons, Secret Lagoon, Shimizu Island and 7 Commandos Beach. Mornings are calmer for kayaking. Tours include a seafood lunch. Boats can be cancelled in bad weather.",
        "interests": [
          "adventure",
          "relax",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "philippines/puerto-princesa-underground": {
        "name": "Puerto Princesa Underground River",
        "description": "A UNESCO subterranean river explored by paddle boat in a limestone cave.",
        "details": "The Underground River is one of the New 7 Wonders of Nature. Boatmen paddle visitors through cathedral-like chambers with stalactites and bats. Permits are limited, so book ahead. The trip is a day from Puerto Princesa or a long day from El Nido.",
        "interests": [
          "iconic_landmarks",
          "adventure",
          "outdoors"
        ],
        "mobility": "L",
        "image": null
      },
      "philippines/cebu-kawasan-moalboal": {
        "name": "Cebu: Kawasan Falls canyoning and Moalboal sardines",
        "description": "A waterfall canyon descent and a snorkel through a sardine school.",
        "details": "Canyoneering at Kawasan Falls in Badian involves jumps and slides. Nearby Moalboal has a huge sardine bait ball just off the beach, plus turtles. Both can be reached from Cebu City in about three hours. Wear sturdy water shoes.",
        "interests": [
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "H",
        "image": null
      },
      "philippines/bohol-chocolate-tarsier": {
        "name": "Bohol Chocolate Hills and tarsiers",
        "description": "Rounded hills turned brown in the dry season, plus the world smallest primate.",
        "details": "The Chocolate Hills are over 1,200 grass-covered mounds, best seen from the Carmen viewing deck. Tarsiers are kept in a sanctuary at Corella, where visitors must stay quiet. A countryside tour includes the Loboc River lunch cruise and Baclayon Church.",
        "interests": [
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "philippines/panglao-beach": {
        "name": "Panglao beaches and dolphin watching",
        "description": "White-sand beaches on Panglao island, with diving at Balicasag.",
        "details": "Alona Beach is the main resort strip on Panglao, and boats go from here to Balicasag Island for snorkelling and early-morning dolphin watching. Sunset on the beach is a pleasant evening. Resorts line the coast.",
        "interests": [
          "relax",
          "outdoors",
          "adventure"
        ],
        "mobility": "L",
        "image": null
      },
      "philippines/siargao-surf": {
        "name": "Siargao surfing and island lagoons",
        "description": "A teardrop island known for Cloud 9 surf and tidal pools.",
        "details": "Siargao is the surfing capital of the Philippines, with Cloud 9 breaking off General Luna. Island hopping reaches Naked Island, Daku Island and Guyam Island, and Sugba Lagoon offers kayaking. Lessons are available for beginners.",
