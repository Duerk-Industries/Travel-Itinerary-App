  "media": {
    "places": {
      "colombia/bogota-candelaria": {
        "name": "La Candelaria and Monserrate",
        "description": "The colonial heart of Bogota, with street art, plazas and a mountaintop church above the city.",
        "details": "La Candelaria has cobbled streets, Botero Museum, the Plaza de Bolivar and murals. Monserrate is reached by cable car or funicular and gives a view over the city at 3,150 metres. Take it easy on the first day because of the altitude.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/gold-museum": {
        "name": "Gold Museum (Museo del Oro)",
        "description": "The world largest collection of pre-Hispanic gold, including the Muisca raft.",
        "details": "The museum displays thousands of gold pieces from Colombian cultures, with a darkened room where the gold glows. It is in the centre of Bogota. Allow two hours, and note that it closes on Mondays.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/zipaquira": {
        "name": "Zipaquira Salt Cathedral",
        "description": "An underground cathedral carved from a salt mine, an hour north of Bogota.",
        "details": "The Salt Cathedral has chambers and crosses carved into halite with coloured lighting. Visits are by guided tour and last about an hour. It is combined with the colonial town of Zipaquira, or with Guatavita lake.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/comuna-13": {
        "name": "Comuna 13 and Medellin metro cable",
        "description": "A once-feared neighbourhood now known for street art, escalators and a tale of transformation.",
        "details": "Comuna 13 is a hillside barrio with graffiti, hip-hop and outdoor escalators. Local guides tell the story of its history of violence and change, so go with a community guide. The metro cable system links the hillside barrios to the city.",
        "interests": [
          "culture",
          "authentic_local",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "colombia/medellin-city": {
        "name": "Medellin Botero Plaza and Parque Arvi",
        "description": "Fernando Botero sculptures in the city centre and a cable car to a forest park.",
        "details": "Plaza Botero has 23 large bronze sculptures beside the Museum of Antioquia. The metro cable to Parque Arvi climbs above the valley to a nature reserve with walking trails. Medellin has a spring-like climate, known as the city of eternal spring.",
        "interests": [
          "culture",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/guatape": {
        "name": "Guatape and El Penol rock",
        "description": "A colourful lakeside town and a giant granite monolith with 740 steps to the top.",
        "details": "El Penol is a rock rising from the lakes, climbed by a staircase for a view over islands and reservoirs. The town of Guatape is known for painted bas-relief house fronts. It is a day trip of two hours each way from Medellin.",
        "interests": [
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "colombia/cocora-valley": {
        "name": "Cocora Valley",
        "description": "A valley of the tallest palm in the world, the wax palm, reached from Salento.",
        "details": "The Cocora Valley loop of about five hours passes cloud forest, hummingbirds and a meadow of wax palms up to 60 metres high. Willys jeeps take hikers from Salento to the trailhead. The path is muddy in places, so wear waterproof footwear.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "colombia/coffee-farm": {
        "name": "Coffee farm tour",
        "description": "A hands-on visit to a coffee finca, from bean to cup, in the Coffee Cultural Landscape.",
        "details": "Farms around Salento offer tours that cover picking, drying, roasting and tasting. The region is a UNESCO World Heritage landscape. Tours take two hours, and some include lunch. Book ahead in busy months.",
        "interests": [
          "food",
          "authentic_local",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/cartagena-old-city": {
        "name": "Cartagena walled city",
        "description": "A colonial Caribbean city of colourful balconies, plazas and fortress walls, a UNESCO site.",
        "details": "The old city is best seen on foot early or at sunset, with the walls, Plaza de Bolivar and the street of Getsemani nearby. The Castillo San Felipe de Barajas is a large fortress. Heat and humidity are intense in the middle of the day, so take a siesta.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/rosario-islands": {
        "name": "Rosario Islands day trip",
        "description": "Boat day to clear water, coral and beaches near Cartagena.",
        "details": "The Islas del Rosario are a short boat ride from Cartagena, with beaches, snorkelling and seafood lunches. Day trips include a stop at a beach club or island. Choose a smaller boat for quieter spots.",
        "interests": [
          "relax",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "colombia/tayrona": {
        "name": "Tayrona National Park",
        "description": "A jungle-backed coast of golden beaches and forest trails near Santa Marta.",
        "details": "Tayrona has beaches such as Cabo San Juan and trails through rainforest. The walk from the park entrance to Cabo San Juan takes about two hours and is hot and humid. Some beaches have dangerous currents, so swim only where permitted. The park closes occasionally for maintenance.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "relax"
        ],
        "mobility": "M",
        "image": null
      }
