    "places": {
      "uzbekistan/tashkent": {
        "name": "Tashkent: Chorsu Bazaar, metro and Khast Imam",
        "description": "A Soviet-era capital with a domed bazaar, painted metro stations and a historic mosque complex.",
        "details": "Tashkent has the Chorsu Bazaar with its blue dome for dried fruit, bread and plov. The metro stations are decorated like palaces, and photography has recently been allowed. Khast Imam holds the Uthman Quran. Taxis are cheap through apps.",
        "interests": [
          "culture",
          "food",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/samarkand-registan": {
        "name": "Samarkand Registan and Gur-e-Amir",
        "description": "Three tile-covered madrasahs on a great square, and the tomb of Timur.",
        "details": "The Registan is one of the most majestic squares in the world, lit up at night. Gur-e-Amir is Timur turquoise-domed mausoleum, and Bibi-Khanym Mosque is immense. The Shah-i-Zinda necropolis is a street of blue-tiled tombs. Visit the Registan at sunset.",
        "interests": [
          "iconic_landmarks",
          "culture",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/samarkand-siab-ulugbek": {
        "name": "Siab Bazaar and Ulugh Beg Observatory",
        "description": "A fresh-produce market and the ruins of a 15th-century observatory.",
        "details": "Siab Bazaar sells bread, nuts and dried fruit. The Ulugh Beg Observatory preserves the base of a giant sextant used for medieval astronomy. Allow half a day. Try Samarkand bread, baked in a clay oven.",
        "interests": [
          "culture",
          "food",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/bukhara-old-town": {
        "name": "Bukhara Lyabi-Hauz, Ark and Kalon Minaret",
        "description": "A living Silk Road city of domed bazaars, a pool plaza and a fortress.",
        "details": "Bukhara has over 140 protected monuments. Lyabi-Hauz is a pool surrounded by old madrasahs and tea houses. The Kalon Minaret is 47 metres tall, and the Ark fortress was the residence of the emirs. Trading domes now sell carpets and crafts.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/bukhara-mausoleums": {
        "name": "Samanid Mausoleum and Chor Minor",
        "description": "A tenth-century brick tomb and a charming four-towered gatehouse.",
        "details": "The Samanid Mausoleum is a masterpiece of brick pattern from the 10th century. Chor Minor is a small madrasah gatehouse with four turquoise towers. Both are a short walk or taxi ride from the centre. Visit in late afternoon light.",
        "interests": [
          "culture",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/khiva-itchan-kala": {
        "name": "Khiva Itchan Kala",
        "description": "A completely walled desert city of mud-brick walls, minarets and blue tile.",
        "details": "Itchan Kala is the inner walled town of Khiva, a UNESCO site, with the unfinished Kalta Minor minaret, Juma Mosque with 213 wooden pillars and Tash Hauli palace. You can climb the walls for sunset. The old town is very pedestrian and quiet in the evening.",
        "interests": [
          "iconic_landmarks",
          "culture",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "uzbekistan/yurt-camp-nurata": {
        "name": "Nurata yurt camp and Aydarkul Lake",
        "description": "An overnight in a yurt in the Kyzylkum desert, with camels and a lake swim.",
        "details": "Between Samarkand and Bukhara, yurt camps at Aydarkul Lake offer camel rides, a campfire and a Uzbek dinner under a vast night sky. Nights are cold in spring and autumn. In summer the lake is good for swimming.",
        "interests": [
