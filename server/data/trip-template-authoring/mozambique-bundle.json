      "mozambique/tofo-diving": {
        "name": "Tofo diving with mantas and whale sharks",
        "description": "A surf and dive beach village famed for manta rays and whale sharks year round.",
        "details": "Tofo is one of the best places in the world to see manta rays, and whale sharks are most common from October to March. Dive and snorkel boats launch from the beach. Humpback whales pass from July to October. The village has simple lodges and surf.",
        "interests": [
          "adventure",
          "outdoors",
