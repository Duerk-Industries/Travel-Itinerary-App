      "mozambique/bazaruto-snorkel": {
        "name": "Bazaruto Archipelago snorkelling and dunes",
        "description": "Coral reefs, dune walks and a national marine park of dugong habitat.",
        "details": "The Bazaruto Archipelago is a marine national park of islands with huge dunes, reefs and seagrass beds that support dugongs. Dune sliding is a popular activity. Lodges on the islands are expensive, and day trips from Vilanculos are cheaper.",
        "interests": [
