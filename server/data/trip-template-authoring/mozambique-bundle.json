          "relax"
        ],
        "mobility": "M",
        "image": null
      },
      "mozambique/tofo-beach": {
        "name": "Tofo and Barra beaches",
        "description": "Long sandy beaches near Inhambane with surf, sunsets and fresh seafood.",
        "details": "Tofo Beach is a laid-back strip with cafes and beach bars. Barra and Praia do Tofinho have good waves, and the old town of Inhambane is a short drive away with a ferry crossing. Take sun protection, as the sun is strong.",
        "interests": [
          "relax",
          "food",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "mozambique/vilanculos-dhow": {
        "name": "Vilanculos dhow sailing",
        "description": "A traditional wooden dhow trip to sandbars and islands in the Bazaruto Archipelago.",
        "details": "Vilanculos is the mainland base for the Bazaruto islands. Traditional dhows sail to Magaruque and Benguerra for snorkelling and sandbanks. The wind can get up in the afternoon, so most trips go in the morning.",
        "interests": [
          "adventure",
