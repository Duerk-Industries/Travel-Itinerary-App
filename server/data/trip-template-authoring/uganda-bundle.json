    "places": {
      "uganda/entebbe-wildlife": {
        "name": "Entebbe Botanical Gardens and wildlife centre",
        "description": "A lakeside garden and a sanctuary for rescued primates and shoebills near the airport.",
        "details": "Entebbe has the Botanical Gardens on Lake Victoria, with monkeys and birds, and the Uganda Wildlife Education Centre, which cares for rescued animals. They are an easy first or last stop near the airport. Mosquito repellent is useful.",
        "interests": [
          "outdoors",
          "relax",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "uganda/jinja-nile": {
        "name": "Jinja, the source of the Nile and rafting",
        "description": "White-water rafting on the Nile and a boat to the source of the longest river in Africa.",
        "details": "Jinja is Uganda adventure capital. Grade 3 to 5 rafting runs on the Nile from a base just downstream of the source, with calm sections for swimming. Quad biking, kayaking and a sunset cruise are other options. Book with a safety-rated operator.",
        "interests": [
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "uganda/murchison-falls": {
        "name": "Murchison Falls National Park",
        "description": "A river that squeezes through a 7-metre gap, with game drives and boat trips below.",
        "details": "Murchison Falls is Uganda largest park. A boat trip from Paraa goes to the base of the falls, passing hippos, crocodiles and elephants on the banks, and a hike leads to the top. Game drives in the north find lions, giraffes and buffalo. Shoebill storks are possible on the Nile delta.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "uganda/kibale-chimps": {
        "name": "Kibale Forest chimpanzee tracking",
        "description": "Habituated chimps in a rainforest with 13 species of primates.",
        "details": "Kibale has one of the highest densities of primates in Africa. Trekkers hike with a ranger to find a habituated chimpanzee community and spend an hour with them. Permits are limited, so book months ahead. The Bigodi Wetland Sanctuary is a bird walk nearby.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "uganda/queen-elizabeth": {
        "name": "Queen Elizabeth National Park and Kazinga Channel",
        "description": "Savannah drives, a hippo-packed channel cruise and the Ishasha tree-climbing lions.",
        "details": "Queen Elizabeth has a mix of savannah, lakes and crater lakes. The Kazinga Channel boat cruise shows hippos, buffalo and elephants at the water. In the Ishasha sector, lions climb fig trees. Early morning and late afternoon drives are best.",
        "interests": [
          "outdoors",
          "adventure",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "uganda/bwindi-gorillas": {
        "name": "Bwindi mountain gorilla trek",
        "description": "A steep forest hike to spend one hour with a habituated mountain gorilla family.",
        "details": "Bwindi Impenetrable Forest holds about half the world mountain gorillas. Treks take 2 to 6 hours over steep, muddy ground, followed by one hour with the family. Permits are limited, so book months ahead. Porters are available to carry bags and help on slopes.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "H",
        "image": null
      },
      "uganda/lake-bunyonyi": {
        "name": "Lake Bunyonyi canoe and island walks",
        "description": "A terraced highland lake dotted with islands, calm and safe for swimming.",
        "details": "Lake Bunyonyi has more than twenty islands. Dugout canoe trips visit villages and islands, and walks climb the terraced hills. It is a restful stop after a gorilla trek. Swimming is safe because the lake is free of bilharzia.",
        "interests": [
          "relax",
          "outdoors",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "uganda/kampala-city": {
        "name": "Kampala Kasubi Tombs and markets",
        "description": "A hilly capital with royal tombs, a hilltop mosque and busy markets.",
        "details": "Kampala has the Kasubi Tombs (rebuilt after a fire), the Gaddafi National Mosque with a minaret view and the Owino market for crafts. Boda-boda motorbike taxis are fast but risky, so choose a car.",
        "interests": [
          "culture",
