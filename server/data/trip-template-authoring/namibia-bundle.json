      },
      "namibia/sesriem-canyon": {
        "name": "Sesriem Canyon and Solitaire",
        "description": "A narrow gorge near the dune park and a bakery at a roadside outpost.",
        "details": "Sesriem Canyon is a 30-metre-deep gorge carved by the Tsauchab River, a short walk from the dune park gate. Solitaire has apple pie and a collection of rusted cars. Both are easy stops on the road.",
        "interests": [
          "outdoors",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "namibia/swakopmund": {
        "name": "Swakopmund adventure and dolphin cruise",
        "description": "A German-flavoured coastal town offering sandboarding, quad biking and a Walvis Bay dolphin cruise.",
        "details": "Swakopmund sits between the cold Atlantic and the Namib dunes. Activities include sandboarding, quad biking and skydiving, plus a catamaran from Walvis Bay to see seals, dolphins and pelicans. The jetty and cafes are pleasant. Mornings can be foggy.",
        "interests": [
          "adventure",
          "outdoors",
          "relax",
          "food"
        ],
        "mobility": "M",
        "image": null
      },
      "namibia/cape-cross": {
        "name": "Cape Cross seal colony",
        "description": "A huge colony of Cape fur seals on the Skeleton Coast, with a strong smell.",
        "details": "Cape Cross holds tens of thousands of fur seals, with pups in November and December. Boardwalks allow viewing at a close but safe distance. It is about an hour north of Swakopmund and on the way to Damaraland.",
        "interests": [
          "outdoors",
          "photography"
        ],
        "mobility": "L",
