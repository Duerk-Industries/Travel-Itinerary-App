      },
      "namibia/twyfelfontein-damaraland": {
        "name": "Twyfelfontein rock engravings and desert elephants",
        "description": "Thousands of ancient rock carvings and a chance to track desert-adapted elephants.",
        "details": "Twyfelfontein is a UNESCO site of San rock engravings, visited with a local guide. Damaraland also has the Organ Pipes, a petrified forest and desert elephants and rhinos which can be tracked with specialist guides. Camps are remote and wild.",
        "interests": [
          "culture",
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "namibia/etosha": {
        "name": "Etosha National Park",
        "description": "A salt-pan reserve with waterholes where elephants, lions, rhinos and giraffes gather.",
        "details": "Etosha is Namibia premier safari park, best in the dry season from May to October, when animals concentrate at waterholes. Self-drive and guided drives are possible, and floodlit waterholes at the camps allow night viewing. Entry fees are paid at the gate.",
