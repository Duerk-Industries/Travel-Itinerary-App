      "cambodia/royal-palace": {
        "name": "Royal Palace and Silver Pagoda",
        "description": "The residence of the king in Phnom Penh, with a pagoda floor of silver tiles.",
        "details": "The Royal Palace has gilded roofs and the Silver Pagoda with its floor of more than 5,000 silver tiles and an emerald Buddha. Dress modestly, covering shoulders and knees. Parts of the palace are closed when the king is present. The riverfront promenade is close by.",
        "interests": [
