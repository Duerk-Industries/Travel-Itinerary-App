      "cambodia/phare-circus": {
        "name": "Phare, The Cambodian Circus",
        "description": "An evening of acrobatics, music and theatre by graduates of an arts school in Battambang.",
        "details": "Phare tells stories through dance, acrobatics and music by young Cambodian artists trained at a charity school, with a nightly show in Siem Reap. Tickets are limited, so book ahead. The show lasts about an hour and is held in a tent.",
