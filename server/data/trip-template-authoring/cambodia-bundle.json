      "cambodia/kampot-river": {
        "name": "Kampot river and pepper farms",
        "description": "A sleepy riverside town with colonial buildings, famous for its pepper, and a sunset river cruise.",
        "details": "Kampot is a laid-back town on the Praek Tuek Chhu river, known for its pepper and salt farms. Day trips visit pepper plantations, caves and the Bokor hill station. A sunset boat trip on the river with a drink is a favourite. The town has hostels, cafes and guesthouses with river views.",
