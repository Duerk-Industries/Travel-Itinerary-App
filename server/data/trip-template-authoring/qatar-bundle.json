  "media": {
    "places": {
      "qatar/museum-islamic-art": {
        "name": "Museum of Islamic Art and the Corniche",
        "description": "The I.M. Pei museum on its own island, with the Doha skyline across the bay.",
        "details": "The Museum of Islamic Art has a collection spanning 1,400 years, including manuscripts, ceramics and metalwork, in a striking limestone building. The Corniche waterfront promenade offers skyline views and a walk to the dhow harbour. It is closed on Tuesdays.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "qatar/souq-waqif": {
        "name": "Souq Waqif",
        "description": "A rebuilt traditional market of spices, textiles, falcons and Arabic coffee.",
        "details": "Souq Waqif is Doha heritage market, with narrow lanes selling spices, perfume and souvenirs, a falcon souq and a falcon hospital. Evening is the most atmospheric, with shisha cafes and Qatari food. Dress modestly, and shops close in the early afternoon.",
        "interests": [
          "culture",
          "food",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "qatar/national-museum": {
        "name": "National Museum of Qatar",
        "description": "A desert-rose building by Jean Nouvel telling the story of Qatar from pearls to gas.",
        "details": "The National Museum is built of interlocking discs like a desert rose, with galleries on nature, pearl diving and modern Qatar. The immersive film rooms are a highlight. Allow three hours. The museum is open every day except Tuesday in some seasons.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "qatar/katara-pearl": {
        "name": "Katara Cultural Village and The Pearl",
        "description": "A cultural district with an amphitheatre and beach, and a marina island with fine dining.",
        "details": "Katara has galleries, a Golden Mosque and an amphitheatre on the sea. The Pearl-Qatar is an artificial island with a marina and Italian-style canals. Evenings are pleasant, as the day heat eases. Both are easy to reach by taxi or the metro.",
        "interests": [
          "relax",
          "food",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "qatar/inland-sea-safari": {
        "name": "Inland Sea desert safari",
        "description": "A 4x4 trip over dunes to Khor Al Adaid, where the sea reaches into the desert.",
        "details": "The Inland Sea is a tidal lagoon surrounded by dunes near the Saudi border, reached by 4x4. Tours include dune bashing, sandboarding, camel rides and a sunset camp. Operators are essential, as navigating the dunes needs expertise. It is hot in summer, so go in winter.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "qatar/al-zubarah": {
        "name": "Al Zubarah Fort and archaeological site",
        "description": "A UNESCO pearling and trading town of the 18th century in the north-west, with a fort.",
        "details": "Al Zubarah was a prosperous pearl and trade town in the 18th and 19th centuries. The fort, built in 1938, houses a small museum, and the ruins spread over the desert. The trip passes Ras Laffan and mangroves at Al Thakira. Allow half a day.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "qatar/mangroves-purple": {
        "name": "Al Thakira mangroves kayaking",
        "description": "A quiet kayak trip through mangroves north of Doha, with birds and desert views.",
        "details": "The Al Thakira mangroves are a calm kayaking spot an hour north of Doha, with herons and flamingos. Tours include paddling through channels. Go in the cooler months and bring sun protection.",
        "interests": [
          "outdoors",
          "relax",
