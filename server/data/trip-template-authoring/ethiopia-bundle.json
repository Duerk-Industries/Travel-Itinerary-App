  "media": {
    "places": {
      "ethiopia/addis-museum": {
        "name": "Addis Ababa National Museum and Merkato",
        "description": "The home of Lucy the fossil hominin, plus the biggest open-air market in Africa.",
        "details": "The National Museum shows Lucy, a 3.2-million-year-old skeleton, and Ethiopian art. The Merkato is a vast market district best seen with a local guide. Entoto hill overlooks the city. Addis is at 2,350 metres, so take it easy on arrival.",
        "interests": [
          "culture",
          "authentic_local",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "ethiopia/coffee-ceremony": {
        "name": "Traditional coffee ceremony and Ethiopian dinner",
        "description": "Roasted, ground and brewed in front of you, with injera and music.",
        "details": "Coffee originated in Ethiopia, and the ceremony includes roasting, grinding and three rounds of coffee with incense. A traditional restaurant serves injera with stews and live azmari music. It is a relaxed introduction to the culture.",
        "interests": [
          "food",
          "culture",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "ethiopia/lake-tana-monasteries": {
        "name": "Lake Tana island monasteries",
        "description": "Ancient monasteries with painted walls on islands in Ethiopia largest lake.",
        "details": "Boat trips from Bahir Dar visit monasteries such as Ura Kidane Mehret, with colourful murals and treasures. Dress modestly and remove shoes at the church doors. The lake has hippos and many birds.",
        "interests": [
          "culture",
          "photography",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "ethiopia/blue-nile-falls": {
        "name": "Blue Nile Falls",
        "description": "A waterfall known as Tis Issat, the smoking water, reached by a short walk.",
        "details": "The Blue Nile Falls are best in the rainy season, from July to October, and are reduced by a hydro scheme in the dry season. The walk from the village crosses a stone bridge. A half-day trip from Bahir Dar.",
        "interests": [
          "outdoors",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "ethiopia/gondar-fasil": {
        "name": "Gondar and Fasil Ghebbi",
        "description": "The castle city of imperial Ethiopia, with a walled compound of stone palaces.",
        "details": "Gondar was the capital in the 17th and 18th centuries. The Fasil Ghebbi royal enclosure is a UNESCO site with castles, and Debre Birhan Selassie church is covered with painted angels on the ceiling. The Fasilides Bath is used at the Timkat festival in January.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "ethiopia/simien-mountains": {
        "name": "Simien Mountains National Park",
        "description": "A dramatic escarpment of peaks and gelada baboons, with day hikes from a lodge.",
        "details": "The Simien Mountains have a rim walk with sweeping drops and troops of gelada baboons grazing on the grass. Day walks of three to six hours start from Simien Lodge or Gich. A scout and guide are required. It is cold at 3,000 metres or higher, and the dry season is October to March.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "H",
        "image": null
      },
      "ethiopia/axum-stelae": {
        "name": "Axum stelae and St Mary of Zion",
        "description": "Giant granite obelisks from the Aksumite empire and a church said to hold the Ark of the Covenant.",
        "details": "Axum was a great ancient kingdom. The stelae field has huge carved obelisks, the tallest standing 24 metres, and a museum. St Mary of Zion is a pilgrimage church, with the chapel claimed to contain the Ark that only one monk may see. Nearby is Yeha, an ancient temple.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "ethiopia/lalibela-churches": {
        "name": "Lalibela rock-hewn churches",
        "description": "Eleven medieval churches carved down into the rock, a UNESCO site and a pilgrimage centre.",
        "details": "The Lalibela churches were carved from solid rock in the 12th and 13th centuries. Bete Giyorgis is shaped like a cross and Bete Medhane Alem is among the largest. Walk barefoot inside, with a guide. Pilgrims fill the town for Genna (Christmas) in January and for Timkat.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "ethiopia/lalibela-hilltop": {
        "name": "Ashetan Maryam church hike",
        "description": "A walk up a hill above Lalibela to a church with views over the valley.",
        "details": "The hike to Ashetan Maryam takes about two hours up, with views of the valleys. It passes Yemrehanna Kristos, an older church in a cave 40 kilometres from town on longer trips. A good activity for the afternoon after the churches.",
        "interests": [
          "outdoors",
          "culture",
          "photography"
        ],
        "mobility": "M",
        "image": null
      }
    },
