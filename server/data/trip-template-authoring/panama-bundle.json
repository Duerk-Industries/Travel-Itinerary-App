    "places": {
      "panama/canal-miraflores": {
        "name": "Panama Canal at Miraflores Locks",
        "description": "Watch ships climb through the locks of one of the greatest engineering projects.",
        "details": "The Miraflores Locks visitor centre has viewing decks, a museum and a film. Ships transit mostly in the morning and afternoon, so check the schedule. The Gatun Locks on the Atlantic side are less crowded. A partial canal transit day cruise is possible.",
        "interests": [
          "iconic_landmarks",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "panama/casco-viejo": {
        "name": "Casco Viejo and Panama City skyline",
        "description": "A restored colonial quarter of plazas, churches and rooftop bars facing the modern skyline.",
        "details": "Casco Viejo is a UNESCO neighbourhood of colourful buildings, plazas and the Panama Canal Museum. Evenings bring rooftop bars with views of the skyline. Cinta Costera gives a bay-side walk. Panama City is hot and humid, so plan indoor breaks.",
        "interests": [
          "culture",
          "food",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "panama/soberania-gamboa": {
        "name": "Soberania National Park and Gamboa rainforest",
        "description": "A rainforest park near the capital with sloths, monkeys and toucans, along the Panama Canal.",
        "details": "Soberania has Pipeline Road, a world-famous birding trail, and the Gamboa rainforest resort has a canopy tower and boat trips on Gatun Lake. Capuchin monkeys, sloths and toucans are regular sightings. Go in the early morning.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "panama/san-blas-guna-yala": {
        "name": "San Blas (Guna Yala) islands",
        "description": "Palm-fringed islands run by the Guna people, with simple cabins and clear water.",
        "details": "The Guna Yala archipelago has over 300 islands, with white sand, snorkelling and Guna culture, including mola textiles. Accommodation is in basic cabins, often with shared bathrooms and limited power. Trips go by 4x4 and boat. Guna entry fees apply.",
        "interests": [
          "relax",
          "authentic_local",
          "outdoors",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "panama/el-valle": {
        "name": "El Valle de Anton",
        "description": "A village in a volcanic crater, with a craft market, hot springs and hikes.",
        "details": "El Valle sits in a crater at 600 metres, cooler than the coast. Highlights include the Sunday market, La India Dormida hike, the square trees, thermal pools and a butterfly house. It is about two hours from Panama City.",
        "interests": [
          "outdoors",
          "relax",
          "authentic_local"
        ],
        "mobility": "M",
        "image": null
      },
      "panama/boquete-coffee": {
        "name": "Boquete coffee tours and cloud forest",
        "description": "Highland coffee farms with tastings, waterfalls and a trail through cloud forest.",
        "details": "Boquete is known for Geisha coffee grown on the slopes of Volcan Baru. Farm tours show picking, roasting and tasting. The Pipeline Trail and the Lost Waterfalls are easy hikes. Climbing Volcan Baru is a night trek for the summit sunrise.",
        "interests": [
          "food",
          "outdoors",
          "adventure",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "panama/bocas-island-hopping": {
        "name": "Bocas del Toro island hopping",
        "description": "A Caribbean archipelago of mangroves, dolphins, beaches and snorkelling.",
        "details": "Bocas Town is the hub for boat tours to Dolphin Bay, Cayo Zapatilla and Starfish Beach. Red Frog Beach has surf and a poison dart frog trail. Rain is common, so choose a flexible day. The islands are relaxed, with water taxis everywhere.",
        "interests": [
          "relax",
