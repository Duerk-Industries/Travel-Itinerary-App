        "image": null
      },
      "fiji/mamanuca-snorkel": {
        "name": "Mamanuca Islands snorkelling and island day",
        "description": "Calm lagoons and coral reefs a short boat ride from Nadi, with beach resorts on small islands.",
        "details": "The Mamanuca group is a chain of sandy islands in a sheltered lagoon, with clear water for snorkelling, paddle-boarding and kayaking. Island resorts are reached by catamaran or speedboat from Denarau Marina. Some islands have surf breaks for experienced riders.",
        "interests": [
          "relax",
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "L",
        "image": null
      },
      "fiji/yasawa-sawa-i-lau": {
        "name": "Yasawa blue lagoon and Sawa-i-Lau cave",
        "description": "A remote island chain of white beaches, with a swimming cave inside a limestone island.",
        "details": "The Yasawas are reached by the Yasawa Flyer catamaran or a seaplane. Sawa-i-Lau is a limestone island with a cave you can swim into, lit from above. Village visits and manta ray snorkelling in season give variety. Lodgings are simple, and electricity may be limited.",
        "interests": [
          "adventure",
          "outdoors",
          "authentic_local",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "fiji/village-kava": {
        "name": "Village visit and kava ceremony",
        "description": "A welcome into a Fijian village, with a kava ceremony, song and a shared meal.",
        "details": "Visits to a Fijian village begin with a sevusevu offering to the chief and a kava ceremony, where a mildly numbing drink is shared from a coconut bowl. Dress modestly, remove hats and do not touch heads. Many resorts organise visits, and a donation to the village is usual.",
        "interests": [
          "culture",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "fiji/coral-coast": {
        "name": "Coral Coast, Sigatoka Dunes and Shark Reef",
        "description": "A resort strip on the south of Viti Levu with sand dunes, river safaris and shark diving.",
        "details": "The Coral Coast has long beaches with gentle reefs, the Sigatoka Sand Dunes National Park and a river valley with village stops. Pacific Harbour offers shark dives and rafting. It is easier by road than the islands, and good for a mainland stay.",
        "interests": [
          "outdoors",
          "adventure",
          "relax",
          "culture"
        ],
        "mobility": "M",
        "image": null
      },
      "fiji/suva-museum": {
        "name": "Suva, museum and municipal market",
        "description": "The capital and port, with a good museum and a bustling market.",
        "details": "Suva has the Fiji Museum in Thurston Gardens with a collection of Fijian artefacts, a colourful municipal market for fruit and kava root, and Colo-i-Suva Forest Park for walks. It is cooler and wetter than the western side.",
        "interests": [
          "culture",
          "authentic_local",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "fiji/taveuni-bouma": {
        "name": "Taveuni waterfalls at Bouma",
        "description": "Rainforest waterfalls and natural swimming holes on the garden island of Fiji.",
        "details": "Bouma National Heritage Park has three Tavoro Waterfalls linked by trails through forest, with swimming pools at the base. Taveuni is known as the Garden Island for its rainforest. Wear walking shoes, and bring repellent.",
        "interests": [
          "outdoors",
          "adventure",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "fiji/taveuni-meridian": {
        "name": "180th meridian and Lavena coastal walk",
        "description": "A marker for the international date line and a scenic coastal trail.",
        "details": "Taveuni is crossed by the 180th meridian, where visitors can stand with one foot in each day. The Lavena Coastal Walk follows the shore to a waterfall at the end of the trail. Combine with a village visit.",
        "interests": [
          "outdoors",
          "photography",
          "culture"
        ],
        "mobility": "M",
        "image": null
      },
      "fiji/rainbow-reef": {
        "name": "Rainbow Reef and Great White Wall dive",
        "description": "Some of the best soft coral diving and snorkelling in the Pacific.",
        "details": "The Somosomo Strait off Taveuni has rich coral gardens, with the Great White Wall a famous dive. Dive operators run trips for certified divers, and snorkel boats visit shallower sites. Currents can be strong, so choose a licensed operator.",
