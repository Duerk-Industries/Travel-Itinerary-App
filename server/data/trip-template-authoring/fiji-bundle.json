      "fiji/nadi-sights": {
        "name": "Nadi temple and Garden of the Sleeping Giant",
        "description": "The largest Hindu temple in the southern hemisphere and an orchid garden in the hills.",
        "details": "Sri Siva Subramaniya Swami Temple in Nadi is a colourful Dravidian temple, open to visitors who dress modestly and remove shoes. The Garden of the Sleeping Giant has orchids and walks in the hills. A relaxed way to spend the first or last afternoon.",
        "interests": [
          "culture",
          "photography",
