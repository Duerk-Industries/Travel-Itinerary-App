  "media": {
    "places": {
      "sri-lanka/colombo": {
        "name": "Colombo temples, Galle Face and markets",
        "description": "A coastal capital of Buddhist temples, a seafront green and Pettah bazaars.",
        "details": "Colombo has Gangaramaya Temple, Beira Lake, the Galle Face Green promenade and the Pettah market area. Arrival is usually late, so a short stop suffices. Try hoppers and kottu roti at a local eatery.",
        "interests": [
          "culture",
          "food",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "sri-lanka/sigiriya": {
        "name": "Sigiriya Rock Fortress",
        "description": "A 200-metre rock with ruins of a fifth-century palace, mirror wall and frescoes.",
        "details": "Sigiriya is climbed by about 1,200 steps to a summit palace ruin, passing frescoed maidens and lion paws. Go at opening (about 7am) to beat the heat and crowds. Pidurangala Rock nearby gives a view of Sigiriya itself at sunset.",
        "interests": [
          "iconic_landmarks",
          "adventure",
          "photography",
          "culture"
        ],
        "mobility": "H",
        "image": null
      },
      "sri-lanka/dambulla-polonnaruwa": {
        "name": "Dambulla cave temples and Polonnaruwa",
        "description": "Painted Buddhist caves and an ancient royal capital explored by bike.",
        "details": "The Dambulla caves hold 150 Buddha statues and painted ceilings. Polonnaruwa is a UNESCO ruined city best seen by bicycle, with the Gal Vihara reclining Buddha. Both lie in the Cultural Triangle. Dress modestly, covering shoulders and knees.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "sri-lanka/kandy-tooth": {
        "name": "Kandy Temple of the Tooth and the lake",
        "description": "A hill-country temple holding a relic of the Buddha, and a lakeside old city.",
        "details": "The Temple of the Tooth is the most sacred Buddhist site in Sri Lanka, with evening puja ceremonies and drumming. Kandy Lake is good for a stroll, and the Royal Botanic Gardens at Peradeniya are a short ride away. Cultural dance shows run nightly.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "sri-lanka/kandy-ella-train": {
        "name": "Kandy to Ella train ride",
        "description": "One of the world most scenic train journeys through tea country, blue-painted carriages and viaducts.",
        "details": "The train from Kandy to Ella (via Nanu Oya) runs through tea plantations, waterfalls and cloud forest. Second-class reserved seats and observation cars sell out, so book ahead. Doors are open for photos, so take care. It takes 6 to 7 hours.",
        "interests": [
          "photography",
          "authentic_local",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "sri-lanka/nuwara-eliya-tea": {
        "name": "Nuwara Eliya tea estates and Horton Plains",
        "description": "Little England of the hills, with tea factory visits, Gregory Lake and a World End cliff walk.",
        "details": "Nuwara Eliya sits at 1,900 metres, cool and misty. Pedro Tea Estate offers tours and tastings. Horton Plains has a 9-kilometre loop to World End, a cliff drop best at dawn before the mist. Bring a jacket.",
        "interests": [
          "outdoors",
          "photography",
          "relax",
          "food"
        ],
        "mobility": "M",
        "image": null
      },
      "sri-lanka/ella-nine-arches": {
        "name": "Ella: Nine Arches Bridge, Little Adam Peak and Ravana Falls",
        "description": "A village of easy hikes with a colonial railway viaduct and waterfalls.",
        "details": "Ella is a laid-back hill village. The Nine Arches Bridge is photographed as the train crosses, Little Adam Peak is an easy sunrise walk and Ella Rock a stiffer hike. Check train times so you are at the bridge at the right moment.",
        "interests": [
          "outdoors",
          "photography",
          "relax",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "sri-lanka/yala-safari": {
        "name": "Yala National Park safari",
        "description": "A jeep safari for leopards, elephants and birds in a coastal national park.",
        "details": "Yala has one of the highest leopard densities in the world, along with elephants, sloth bears and crocodiles. Morning and afternoon jeeps start at dawn or 2pm. Book a reputable driver, and note that the park closes for some weeks in the dry season.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "sri-lanka/mirissa-whales": {
        "name": "Mirissa whale watching and beach",
        "description": "Blue whale season cruises and a palm-lined south coast beach.",
        "details": "Mirissa has boat trips to see blue whales and dolphins, from about November to April. The beach is good for swimming and has a famous palm-tree point (Coconut Tree Hill). Choose a responsible whale-watching operator and take seasickness tablets.",
        "interests": [
          "relax",
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "sri-lanka/galle-fort": {
        "name": "Galle Fort",
        "description": "A Dutch-era walled fort on the sea with cafes, boutiques and a lighthouse.",
        "details": "Galle Fort is a UNESCO site with ramparts you can walk at sunset, colonial houses, a lighthouse and small galleries. Cafes and restaurants fill the lanes. Unawatuna beach is a short ride away.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "relax"
        ],
        "mobility": "L",
        "image": null
      }
    },
