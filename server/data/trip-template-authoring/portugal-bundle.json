      "portugal/coimbra": {
        "name": "Coimbra University and Biblioteca Joanina",
        "description": "Portugal oldest university, with a baroque library and a hilltop old town.",
        "details": "Coimbra University sits on a hill with a baroque library, the Biblioteca Joanina, which has bat colonies protecting the books. Fado de Coimbra is sung by students. Allow a day. Ticket slots for the library are timed.",
        "interests": [
          "culture",
          "iconic_landmarks",
