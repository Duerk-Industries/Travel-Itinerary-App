      "portugal/porto-ribeira": {
        "name": "Porto Ribeira, Livraria Lello and port cellars",
        "description": "A riverside old town, a famous bookshop and port wine lodges across the Douro.",
        "details": "Porto has the Ribeira waterfront, the Dom Luis I bridge, the azulejo-covered Sao Bento station and Livraria Lello. Across the river in Vila Nova de Gaia, port lodges offer tours and tastings. Try a francesinha sandwich.",
        "interests": [
          "culture",
          "food",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "portugal/douro-valley": {
        "name": "Douro Valley wine and river cruise",
        "description": "Terraced vineyards along a winding river, with quintas serving lunch and tastings.",
        "details": "The Douro is the oldest demarcated wine region in the world, with terraced vineyards in a UNESCO landscape. River cruises from Pinhao or Peso da Regua run through the valley, and quintas offer tastings. Harvest in autumn is the liveliest time. A train line follows the river.",
        "interests": [
          "food",
          "relax",
          "photography",
          "outdoors"
        ],
        "mobility": "L",
        "image": null
      },
      "portugal/obidos-nazare": {
        "name": "Obidos and Nazare",
        "description": "A walled medieval village with cherry liqueur, and a surf town famed for giant waves.",
        "details": "Obidos is a whitewashed village with walls you can walk and ginjinha served in chocolate cups. Nazare has a beach, a funicular to the fishermen quarter and the Praia do Norte, where big waves roll in winter. They sit on the road between Lisbon and Porto.",
        "interests": [
          "culture",
          "photography",
          "food"
        ],
        "mobility": "L",
