          "iconic_landmarks",
          "photography",
          "food"
        ],
        "mobility": "M",
        "image": null
      },
      "portugal/lisbon-fado-food": {
        "name": "Fado dinner and Time Out Market",
        "description": "An evening of Portuguese fado music, and a market hall for seafood and petiscos.",
        "details": "Fado is the soulful music of Portugal, performed in small houses in Alfama and Bairro Alto. Book dinner with a show and keep quiet during songs. The Time Out Market at Cais do Sodre is a food hall of top chefs.",
        "interests": [
          "culture",
          "food",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "portugal/sintra-cascais": {
        "name": "Sintra palaces and Cascais coast",
        "description": "Fairytale hilltop palaces, then a seaside town and the cliffs of Cabo da Roca.",
        "details": "Sintra has the colourful Pena Palace, the Moorish Castle and Quinta da Regaleira with its initiation well. Queue early, and use the bus or tuk-tuk between sites. Cascais has beaches and a coastal path, and Cabo da Roca is the westernmost point of mainland Europe.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "portugal/evora": {
        "name": "Evora Roman temple and Chapel of Bones",
        "description": "A walled Alentejo city with a Roman temple, a cathedral and a chapel of human bones.",
        "details": "Evora is a UNESCO city with the Temple of Diana, a cathedral with rooftop access and the Capela dos Ossos, a chapel decorated with human skulls. The Alentejo region is known for cork, wine and slow food. A day trip from Lisbon or an overnight.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "food"
        ],
        "mobility": "L",
