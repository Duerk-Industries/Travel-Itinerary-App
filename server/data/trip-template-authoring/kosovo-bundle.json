        "name": "Gjakova old bazaar",
        "description": "A rebuilt Ottoman bazaar with craft shops and a hamam, in the west of Kosovo.",
        "details": "The Old Bazaar of Gjakova has cobbled lanes with cobblers, tinsmiths and spice sellers, plus the Hadum Mosque. It was damaged in the war and later restored. Allow a couple of hours on the way between Prizren and Peja.",
        "interests": [
          "culture",
          "authentic_local",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "kosovo/decani-monastery": {
        "name": "Visoki Decani Monastery",
        "description": "A medieval monastery with exceptional frescoes, guarded by international troops.",
        "details": "Visoki Decani is a UNESCO-listed Serbian Orthodox monastery with a great marble church from the 14th century. A permit or ID may be needed at the checkpoint, and visitors should dress modestly and keep quiet. Monks sometimes sell wine and honey.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "kosovo/peja-patriarchate": {
        "name": "Peja and the Patriarchate of Pec",
        "description": "A mountain-edge town with a historic monastery complex and a lively bazaar.",
        "details": "The Patriarchate of Pec is a group of medieval churches with frescoes, once the seat of the Serbian church. Peja has a traditional bazaar, a clock tower and the Peja brewery. The Rugova mountains rise right behind the town.",
        "interests": [
          "culture",
