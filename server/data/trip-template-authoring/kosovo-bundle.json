      "kosovo/prizren-old-town": {
        "name": "Prizren old town and fortress",
        "description": "An Ottoman-style town on a river with a stone bridge, mosques and a hilltop fortress.",
        "details": "Prizren is the most picturesque city in Kosovo, with the Stone Bridge, the Sinan Pasha Mosque and the Kalaja fortress above. The old bazaar has traditional crafts and filigree. The Dokufest film festival is in August. A walk up to the fortress at sunset gives the best view.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "authentic_local"
        ],
        "mobility": "M",
