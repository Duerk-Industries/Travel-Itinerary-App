          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "sweden/visby-gotland": {
        "name": "Visby on Gotland",
        "description": "A medieval walled town on a Baltic island, with roses, ruins and rauk sea stacks.",
        "details": "Visby is a UNESCO-listed Hanseatic town with a 3-kilometre wall and cathedral ruins. Gotland has cycle paths, limestone sea stacks at Fårö and beaches. The Medieval Week festival is in August. Ferries run from Nynashamn.",
        "interests": [
