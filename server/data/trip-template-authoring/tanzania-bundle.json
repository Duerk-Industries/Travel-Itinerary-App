          "authentic_local",
          "food"
        ],
        "mobility": "M",
        "image": null
      },
      "tanzania/tarangire": {
        "name": "Tarangire National Park",
        "description": "Baobab-studded park with huge elephant herds, best in the dry season.",
        "details": "Tarangire is known for its ancient baobab trees and large herds of elephants gathering by the river from June to October. Tree-climbing lions and pythons are possible. It is a good first stop on a northern circuit.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/lake-manyara": {
        "name": "Lake Manyara National Park",
        "description": "A small park on the Rift Valley escarpment, with a soda lake, flamingos and tree-climbing lions.",
        "details": "Lake Manyara has groundwater forest with baboons and elephants, and the lake often holds flamingos and pelicans. It is a good half-day stop on the way to Ngorongoro. Tree-climbing lions are sometimes seen.",
        "interests": [
          "outdoors",
          "photography",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/ngorongoro-crater": {
        "name": "Ngorongoro Crater",
        "description": "A volcanic caldera with a dense population of wildlife and a rim lodge view.",
        "details": "The Ngorongoro Crater is a 260-square-kilometre caldera floor with lions, black rhino, hippos and flamingos. Game drives descend at dawn, with a picnic on the floor. The rim is cool and often misty. Only a limited number of vehicles are allowed in at a time.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/serengeti-game-drive": {
        "name": "Serengeti game drives",
        "description": "Endless plains with lions, leopards, cheetahs and the great wildebeest migration.",
        "details": "The Serengeti has big cats all year. The wildebeest herds move in a circle: calving on the southern plains from January to March, the western corridor in May to June, the northern river crossings from July to October. Your lodge location depends on the season. Game drives run at dawn and late afternoon.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/serengeti-balloon": {
        "name": "Serengeti balloon safari",
        "description": "A dawn hot-air balloon flight over the plains with a champagne breakfast.",
        "details": "Balloons lift off from the central Serengeti at first light and float for an hour, followed by a bush breakfast. Flights depend on the weather and book early. Allow a morning free.",
        "interests": [
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/stone-town": {
        "name": "Stone Town and spice tour",
        "description": "A UNESCO old town of carved doors, a sultan palace and spice farms on the island.",
        "details": "Stone Town has narrow lanes, the House of Wonders, Forodhani night food market and carved Zanzibari doors. A spice tour visits farms to taste cloves, vanilla and cinnamon. The Prison Island tortoise sanctuary is a short boat ride away. Dress modestly in this Muslim town.",
        "interests": [
          "culture",
          "food",
          "iconic_landmarks",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "tanzania/nungwi-beach": {
        "name": "Nungwi and Kendwa beaches",
        "description": "White sand beaches on the northern tip of Zanzibar, with dhow cruises and snorkelling.",
        "details": "Nungwi and Kendwa have white sand and warm water that stays deep at low tide. Dhow sunset cruises, snorkelling at Mnemba atoll and diving are options. Seasons: the long rains in April and May are quieter.",
