      "tanzania/arusha-materuni": {
        "name": "Arusha town, coffee tour and Materuni Waterfall",
        "description": "A safari gateway with a coffee farm tour and a waterfall walk on the Kilimanjaro foothills.",
        "details": "Arusha is the base for northern safaris. Nearby, the Materuni village near Moshi offers a coffee tour and a hike to a 80-metre waterfall with Kilimanjaro views on clear days. Nearby Arusha National Park has giraffes and colobus monkeys.",
        "interests": [
          "culture",
