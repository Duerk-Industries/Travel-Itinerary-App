    "places": {
      "madagascar/antananarivo-rova": {
        "name": "Antananarivo Rova and Analakely market",
        "description": "The hilltop royal palace and the busy markets of the highland capital.",
        "details": "The Rova of Antananarivo was the palace of the Merina kings and sits above the city. Narrow stairways, markets and colourful minibuses fill the lower town. The city is chaotic and busy, so a guide helps on a first morning.",
        "interests": [
          "culture",
          "authentic_local",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": {
          "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Palais_Royale_de_ROVA_Manjaka-miadana_03.jpg/960px-Palais_Royale_de_ROVA_Manjaka-miadana_03.jpg",
          "width": 960,
          "height": 720,
          "title": "File:Palais Royale de ROVA Manjaka-miadana 03.jpg",
          "pageUrl": "https://commons.wikimedia.org/wiki/File:Palais_Royale_de_ROVA_Manjaka-miadana_03.jpg",
          "license": "CC0",
          "author": "Lalinah",
          "selection": "ai"
        }
      },
      "madagascar/andasibe-indri": {
        "name": "Andasibe-Mantadia and the indri",
        "description": "A rainforest park where the largest living lemur, the indri, sings across the canopy.",
        "details": "Andasibe holds indri family groups that give a haunting call at dawn. Guides lead morning and night walks to find lemurs, chameleons and frogs. The park is about three hours from the capital, and the forest is damp and cool. Leech socks and rain gear help.",
        "interests": [
          "outdoors",
          "photography",
          "adventure",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "madagascar/ranomafana": {
        "name": "Ranomafana National Park",
        "description": "Rainforest in the southern highlands with golden bamboo lemurs and hot springs.",
        "details": "Ranomafana has trails to sifakas, bamboo lemurs and chameleons, plus a thermal spring to soak in after a hike. Trails are steep and slippery in the rain. The park is a UNESCO site, reached after a long day on the RN7 road from Antananarivo.",
        "interests": [
          "outdoors",
          "adventure",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "madagascar/anja-ring-tailed": {
        "name": "Anja Community Reserve ring-tailed lemurs",
        "description": "A community-run reserve with troops of ring-tailed lemurs on rocky outcrops.",
        "details": "The small Anja reserve is run by local villagers, and visitors can walk among ring-tailed lemurs, chameleons and caves. A short stop on the road between Ranomafana and Isalo. Fees fund the local community.",
        "interests": [
          "outdoors",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "madagascar/isalo": {
        "name": "Isalo National Park",
        "description": "Sandstone canyons, natural pools and sunset views in the arid south.",
        "details": "Isalo has rock formations, canyons and the Piscine Naturelle swimming hole. Walks of different lengths pass lemur troops and Bara tombs. The sunset from the Window of Isalo is a classic. Daytime heat is high, so start early and carry water.",
        "interests": [
          "outdoors",
          "photography",
          "adventure",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "madagascar/ifaty-reniala": {
        "name": "Ifaty beach and Reniala spiny forest",
        "description": "A coast of reef-fringed beaches and a spiny forest with baobabs and hopping lizards.",
        "details": "Ifaty sits near Toliara on the south-west coast, with Vezo fishing villages, snorkelling and, in season, humpback whales from July to September. The Reniala Reserve has ancient baobabs and spiny forest. Take sun protection.",
        "interests": [
          "relax",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "madagascar/baobab-avenue": {
        "name": "Avenue of the Baobabs",
        "description": "A dirt road lined with giant baobab trees, glowing at sunset near Morondava.",
        "details": "The Avenue of the Baobabs is a short drive from Morondava, and the best light is at sunrise and sunset. Nearby are Kirindy Forest, where fossas can be seen on night walks, and the Baobab Amoureux. Roads are rough in the wet season.",
        "interests": [
          "photography",
          "iconic_landmarks",
          "outdoors"
        ],
        "mobility": "L",
        "image": null
      },
      "madagascar/nosy-be": {
        "name": "Nosy Be and Nosy Iranja",
        "description": "A tropical island base for beaches, snorkelling and the lemur island of Nosy Komba.",
        "details": "Nosy Be is the main beach destination, with boat trips to Nosy Komba (black lemurs), Nosy Tanikely (snorkelling) and the sand spit of Nosy Iranja. Whale sharks are present in the cooler months. Conditions are best from May to November.",
        "interests": [
          "relax",
          "outdoors",
          "photography",
          "adventure"
        ],
