  "media": {
    "places": {
      "ecuador/quito-old-town": {
        "name": "Quito Historic Centre and Teleferiqo",
        "description": "A UNESCO colonial old town and a cable car to a 4,000-metre volcano ridge.",
        "details": "Quito old town has plazas, baroque churches such as La Compania and views from the Panecillo hill. The Teleferiqo cable car climbs Pichincha volcano to about 4,000 metres. Take it slowly, because Quito is at 2,850 metres and altitude is noticeable.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "ecuador/mitad-del-mundo": {
        "name": "Middle of the World",
        "description": "The monument and museum on the equator line north of Quito.",
        "details": "The Mitad del Mundo complex marks the equator with a monument and a museum, though the true line found by GPS is nearby at the Intinan Museum. Visitors can balance an egg or watch water swirl. It is a short half-day trip from Quito.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "ecuador/otavalo-market": {
        "name": "Otavalo Market and Cuicocha Lake",
        "description": "A famous indigenous market of textiles and crafts, with a crater lake nearby.",
        "details": "The Saturday market in Otavalo is the largest in the Andes for woven textiles, jewellery and crafts, with a smaller market on other days. Cuicocha is a crater lake with a walking trail. The town is two hours north of Quito.",
        "interests": [
          "authentic_local",
          "culture",
          "photography",
          "outdoors"
        ],
        "mobility": "L",
        "image": null
      },
      "ecuador/cotopaxi": {
        "name": "Cotopaxi National Park",
        "description": "One of the highest active volcanoes in the world, with a visitor centre, lake and trails.",
        "details": "Cotopaxi rises to 5,897 metres. Day visits drive to the car park at about 4,500 metres and walk to the Jose Ribas refuge, and cycling downhill is popular. Altitude sickness is a risk, so acclimatise first in Quito. Weather changes fast, and the cone is often hidden.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "H",
        "image": null
      },
      "ecuador/quilotoa": {
        "name": "Quilotoa Lake",
        "description": "A turquoise crater lake at 3,900 metres, with a steep hike to the shore.",
        "details": "Quilotoa is a volcanic crater filled with a green-blue lake, reached from the rim by a steep path of about 30 minutes down and a harder walk back up. Mules can carry tired hikers. Dress warmly, because the rim is cold and windy.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "H",
        "image": null
      },
      "ecuador/banos-waterfalls": {
        "name": "Banos waterfalls and thermal baths",
        "description": "An adventure town in a river valley, famed for waterfalls, hot springs and the Swing at the End of the World.",
        "details": "Banos sits at the foot of Tungurahua volcano. The Ruta de las Cascadas by bike or bus reaches the Pailon del Diablo waterfall. Evenings are for thermal baths, and the town offers canyoning, rafting and ziplining. Check the volcano activity status.",
        "interests": [
          "adventure",
          "outdoors",
          "relax",
          "photography"
        ],
        "mobility": "M",
        "image": {
          "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Pail%C3%B3n_del_Diablo%2C_cerca_a_Ba%C3%B1os%2C_Ecuador_%283258%29.jpg/960px-Pail%C3%B3n_del_Diablo%2C_cerca_a_Ba%C3%B1os%2C_Ecuador_%283258%29.jpg",
          "width": 960,
          "height": 640,
          "title": "File:Pailón del Diablo, cerca a Baños, Ecuador (3258).jpg",
          "pageUrl": "https://commons.wikimedia.org/wiki/File:Pail%C3%B3n_del_Diablo,_cerca_a_Ba%C3%B1os,_Ecuador_(3258).jpg",
          "license": "CC0",
          "author": "Sebastian Reategui",
          "selection": "ai"
        }
      },
      "ecuador/cuenca-old-town": {
        "name": "Cuenca historic centre",
        "description": "A colonial city of domed cathedral, flower market and Panama hat workshops.",
        "details": "Cuenca is a UNESCO city with a river, cobbled streets and the blue-domed New Cathedral. Panama hats are made here, not in Panama, and workshops show the process. The Pumapungo museum has Inca ruins and a bird park.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "ecuador/cajas": {
        "name": "Cajas National Park",
        "description": "A high moorland of hundreds of glacial lakes, near Cuenca.",
        "details": "Cajas lies at over 3,000 metres, with lakes, rocky paths and polylepis forest. Short and long trails are marked. Weather is cold and often misty, so bring waterproofs. It is half an hour from Cuenca.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "ecuador/darwin-station": {
        "name": "Charles Darwin Research Station",
        "description": "A research centre in Puerto Ayora, with giant tortoise breeding and land iguanas.",
        "details": "The Darwin Station shows the conservation work for giant tortoises. Walk there from Puerto Ayora along a path past cacti, and see tortoises of different ages. Fish market sea lions are a free show at the harbour.",
        "interests": [
          "culture",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": {
          "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Galapagos_Land_Iguana.jpg/960px-Galapagos_Land_Iguana.jpg",
          "width": 960,
          "height": 720,
          "title": "File:Galapagos Land Iguana.jpg",
          "pageUrl": "https://commons.wikimedia.org/wiki/File:Galapagos_Land_Iguana.jpg",
          "license": "CC0",
          "author": "Balon Greyjoy",
          "selection": "ai"
        }
      },
      "ecuador/tortoise-highlands": {
        "name": "Santa Cruz highlands tortoises and lava tunnels",
        "description": "Giant tortoises in the wild on farmland, and a tunnel formed by lava.",
        "details": "The highlands of Santa Cruz are home to free-roaming giant tortoises on private reserves, seen from a few metres. Nearby are the Los Gemelos twin craters and a lava tunnel to walk through. Wear rubber boots, which reserves lend.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "L",
        "image": null
      },
      "ecuador/tortuga-bay": {
        "name": "Tortuga Bay",
        "description": "A white-sand beach where marine iguanas and sea turtles gather, reached by a long path.",
        "details": "The 2.5-kilometre path from Puerto Ayora leads to Tortuga Bay, where marine iguanas rest on the sand and swimming is allowed at the calm lagoon further along. Bring water and sun protection, as there is little shade.",
        "interests": [
          "relax",
          "outdoors",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "ecuador/bartolome": {
        "name": "Bartolome and North Seymour day trip",
        "description": "A volcanic island with a famous summit view, penguins and snorkelling.",
        "details": "Day cruises from Santa Cruz visit Bartolome, with a boardwalk to the summit and a view of Pinnacle Rock, and snorkelling with penguins and sea turtles. Another option is North Seymour for frigatebirds and blue-footed boobies. Tours need a licensed guide.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      }
