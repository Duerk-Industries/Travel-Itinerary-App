    "places": {
      "kenya/nairobi-wildlife": {
        "name": "Giraffe Centre and Elephant Orphanage",
        "description": "Feed Rothschild giraffes by hand and watch orphaned baby elephants being fed.",
        "details": "The Giraffe Centre on the edge of Nairobi lets visitors feed giraffes from a raised platform. The David Sheldrick elephant orphanage holds a daily one-hour public viewing at 11am, when keepers bottle-feed young elephants. Book ahead for the foster visit. Both are easy half-day stops.",
        "interests": [
          "outdoors",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "kenya/amboseli": {
        "name": "Amboseli National Park",
        "description": "Large elephant herds against the backdrop of snow-capped Mount Kilimanjaro.",
        "details": "Amboseli is known for big-tusked elephants and open plains with Kilimanjaro rising behind, clearest at dawn and dusk. Game drives also find lions, buffalo and hippos in swamps. Dust is common in the dry season, so carry a scarf. Park fees are paid per person per day.",
        "interests": [
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "kenya/lake-nakuru": {
        "name": "Lake Nakuru National Park",
        "description": "A soda lake park for rhinos, flamingos and tree-climbing lions.",
        "details": "Lake Nakuru protects white and black rhino, with thousands of flamingos on the water in some seasons. A small park, it can be covered in a half-day or a full day of drives, with a viewpoint at Baboon Cliff. Water levels change the flamingo numbers.",
        "interests": [
          "outdoors",
          "photography",
          "adventure"
        ],
        "mobility": "L",
        "image": null
      },
      "kenya/naivasha-hells-gate": {
        "name": "Lake Naivasha and Hell Gate",
        "description": "A freshwater lake with boat trips and a gorge park where visitors can cycle or walk among zebras.",
        "details": "Boats on Naivasha get close to hippos and fish eagles. In Hell Gate National Park you can cycle or walk between giraffes and zebra, and hike through the Njorowa Gorge. It is a good half-day on a transfer day.",
        "interests": [
          "outdoors",
          "adventure",
          "relax"
        ],
        "mobility": "M",
        "image": null
      },
      "kenya/masai-mara": {
        "name": "Masai Mara game drives",
        "description": "Kenya premier reserve for lions, leopards, cheetahs and the great migration.",
        "details": "The Mara has big cats all year, and the wildebeest migration crosses the Mara River from about July to October. Dawn and dusk drives are best. Park fees are higher in the high season, and conservancies offer fewer vehicles and night drives. Bring binoculars.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "kenya/mara-balloon": {
        "name": "Masai Mara balloon safari",
        "description": "A dawn hot-air balloon flight over the plains, followed by a bush breakfast.",
        "details": "Balloons lift off at first light and float over the herds for about an hour, then land for a champagne breakfast. Flights depend on weather and carry a limited number of passengers. Book early in the migration season.",
        "interests": [
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "kenya/maasai-village": {
        "name": "Maasai village visit",
        "description": "A cultural visit to a Maasai homestead with song, dance and beadwork.",
        "details": "Visits to a Maasai manyatta show the traditional way of life, with jumping dances, fire-making and crafts. Choose a community-run visit and ask what the fee supports. Dress modestly and ask before photographing people.",
        "interests": [
          "culture",
