      },
      "kenya/diani-beach": {
        "name": "Diani Beach",
        "description": "A long white-sand beach on the Indian Ocean with reef snorkelling, dhow trips and colobus monkeys.",
        "details": "Diani has soft white sand, warm water and a lagoon behind the reef. Activities include dhow trips to Wasini and Kisite Marine Park for dolphins, kite-surfing and the Colobus Trust. The coast is hot and humid, and calmer from January to March.",
