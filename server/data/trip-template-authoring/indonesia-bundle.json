    "places": {
      "indonesia/ubud-rice-temples": {
        "name": "Ubud rice terraces and temples",
        "description": "Tegalalang terraces, Tirta Empul holy springs and the Sacred Monkey Forest.",
        "details": "Ubud is the cultural heart of Bali. Tegalalang has stepped rice paddies and jungle swings, Tirta Empul has a purification ritual in spring-fed pools, and the Monkey Forest is a sanctuary of macaques and temples. A sarong is required at temples. Mornings are less crowded.",
        "interests": [
          "culture",
          "photography",
