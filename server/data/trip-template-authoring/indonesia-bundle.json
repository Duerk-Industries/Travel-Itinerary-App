          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "indonesia/batur-sunrise": {
        "name": "Mount Batur sunrise trek",
        "description": "A pre-dawn volcano climb with breakfast cooked by steam at the summit.",
        "details": "Mount Batur takes about two hours to climb in the dark, arriving for sunrise over the crater lake. Guides are required. The path is rocky and cool, so bring a layer and a headlamp. Trips usually leave Ubud around 2am.",
        "interests": [
          "adventure",
          "outdoors",
          "photography"
        ],
        "mobility": "H",
        "image": null
      },
      "indonesia/bali-dance-kecak": {
        "name": "Balinese dance, Kecak at Uluwatu",
        "description": "A sunset fire dance in a clifftop temple, with chanting by a circle of men.",
        "details": "The Kecak dance at Uluwatu Temple performs the Ramayana as a chorus of 70 men chant at sunset. Keep sunglasses secure, because macaques steal items. Ubud also stages Legong and Barong dances in the evenings.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "indonesia/bali-beaches-temples": {
        "name": "Tanah Lot and Seminyak beaches",
        "description": "A sea temple at sunset and a long surf-lined beach with beach clubs.",
        "details": "Tanah Lot is a temple on a rock in the sea that is best at sunset, though busy. Seminyak and Canggu have black-sand beaches, surf schools, cafes and sunset bars. Strong currents on some beaches, so swim between the flags.",
        "interests": [
          "relax",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "indonesia/nusa-penida": {
        "name": "Nusa Penida island day trip",
        "description": "Dramatic cliffs, Kelingking viewpoint and snorkelling with manta rays.",
        "details": "Nusa Penida is reached by fast boat from Sanur in about 40 minutes. The Kelingking Beach cliff, Angel Billabong and Crystal Bay are popular. Roads are rough, so go with a driver. Sea conditions can cancel boats.",
        "interests": [
          "adventure",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "indonesia/yogyakarta-kraton": {
        "name": "Yogyakarta Kraton and Malioboro",
        "description": "The sultan palace, the water castle and the busy shopping street of batik and street food.",
        "details": "Yogyakarta is the cultural heart of Java, with the Kraton, the Taman Sari water castle and a batik quarter. Malioboro Street is lined with stalls and food carts. Gamelan music is performed in the Kraton on certain mornings.",
        "interests": [
          "culture",
          "food",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "indonesia/borobudur-prambanan": {
        "name": "Borobudur sunrise and Prambanan",
        "description": "The largest Buddhist temple in the world, and a great Hindu temple complex.",
        "details": "Borobudur rises in tiers of stone with 504 Buddha statues, and sunrise visits from a nearby hotel are the best way to experience it. Prambanan has soaring Hindu towers. A guide helps explain the carvings. The climb to Borobudur levels is limited to protect the stone, with tickets limited.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "indonesia/gili-snorkel": {
        "name": "Gili Islands snorkelling with turtles",
        "description": "Car-free islands off Lombok with turtle-filled reefs and sunset bars.",
        "details": "The Gili islands have no motor vehicles, and transport is by bicycle or horse cart. Gili Air is the quietest, and snorkelling off the beach spots green sea turtles. Fast boats leave from Bali in about 1.5 to 2 hours.",
        "interests": [
          "relax",
          "outdoors",
          "adventure"
        ],
        "mobility": "L",
        "image": null
      },
      "indonesia/komodo-national-park": {
        "name": "Komodo National Park",
        "description": "A boat cruise to see Komodo dragons, pink beach and manta ray reefs.",
        "details": "Komodo National Park has the only wild Komodo dragons, seen on guided walks led by rangers on Komodo and Rinca islands. Boats continue to Padar for the viewpoint, Pink Beach and manta point for snorkelling. Day trips or liveaboards run from Labuan Bajo. Keep to the rangers instructions.",
