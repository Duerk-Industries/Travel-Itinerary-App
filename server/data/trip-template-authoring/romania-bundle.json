      "romania/peles-sinaia": {
        "name": "Peles Castle and Sinaia",
        "description": "A neo-Renaissance royal castle in a forest of the Carpathian foothills.",
        "details": "Peles was the summer palace of King Carol I and has richly decorated rooms with carved wood. Sinaia is a mountain resort with a cable car. The castle is closed on Mondays and tours need timed tickets in summer.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
