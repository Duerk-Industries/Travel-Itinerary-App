      "romania/brasov-old-town": {
        "name": "Brasov Black Church and Council Square",
        "description": "A Saxon medieval town beneath a mountain, with a large Gothic church.",
        "details": "Brasov is the heart of southern Transylvania, with the Black Church, Council Square and Rope Street, one of the narrowest in Europe. A cable car climbs Mount Tampa for views. Cafes and restaurants fill the old centre in the evenings.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "romania/bran-rasnov": {
        "name": "Bran Castle and Rasnov Fortress",
        "description": "The Dracula castle legend and a peasant fortress on a nearby hill.",
        "details": "Bran Castle sits on a rock and is linked to Bram Stoker novel, though the real Vlad connection is slight. Rasnov Citadel is a fortified peasant refuge with views. Both are within 30 minutes of Brasov. Go early to beat the coaches.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "romania/sighisoara": {
        "name": "Sighisoara citadel",
        "description": "A UNESCO medieval citadel with painted houses and clock tower, birthplace of Vlad the Impaler.",
        "details": "Sighisoara is one of the best-preserved inhabited citadels in Europe. The Clock Tower has a museum and view, and the Scholars Stairs lead to a Gothic church. Colourful houses fill the lanes, and the old town is lovely at night.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "romania/viscri": {
        "name": "Viscri fortified church and Saxon villages",
        "description": "A UNESCO fortified church in a rural village of horse carts and Prince Charles guesthouse.",
        "details": "Viscri has a 12th-century fortified church and a village life largely untouched by modern times, with horse-drawn carts and homemade jam. The Saxon fortified churches of Transylvania are unique to the region. A day trip from Sighisoara or Brasov.",
        "interests": [
          "culture",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "romania/sibiu": {
        "name": "Sibiu Large Square and Transfagarasan",
        "description": "A European Capital of Culture with houses that watch you, and the spectacular mountain road nearby.",
        "details": "Sibiu has three squares, the Bridge of Lies and the roofs with eye-like windows. ASTRA Museum is an open-air museum of rural life. The Transfagarasan road crosses the Fagaras mountains and is open from about July to October.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
