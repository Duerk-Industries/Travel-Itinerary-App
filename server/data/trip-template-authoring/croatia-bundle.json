  "media": {
    "places": {
      "croatia/zagreb-upper-town": {
        "name": "Zagreb Upper Town and Dolac Market",
        "description": "The hilltop old town of Zagreb with St Mark Church, plus the farmers market below.",
        "details": "Gornji Grad is reached by the short funicular and holds St Mark Church with its coloured tile roof, the Stone Gate and the Lotrscak tower, whose cannon fires at noon. Dolac market is at the foot of the hill. Cafes on Tkalciceva Street are lively in the evening.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "croatia/plitvice-lakes": {
        "name": "Plitvice Lakes National Park",
        "description": "Sixteen terraced lakes joined by waterfalls and wooden boardwalks, a UNESCO site.",
        "details": "Plitvice is famed for turquoise lakes and cascades that you walk past on boardwalks and by boat. Routes range from two to six hours. Go early or late to avoid crowds, and book timed tickets in summer. Swimming is not allowed. In winter, parts are icy.",
        "interests": [
          "outdoors",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "croatia/rovinj": {
        "name": "Rovinj old town",
        "description": "A Venetian-style fishing town on a peninsula in Istria, with a hilltop church and harbour restaurants.",
        "details": "Rovinj has steep cobbled lanes, art galleries and the church of St Euphemia, whose tower is climbed for a view. Istria is famed for truffles, olive oil and wines. Beach swimming is from rocks or small coves, and a boat trip to the Red Island is popular.",
        "interests": [
          "culture",
          "food",
          "photography",
          "relax"
        ],
        "mobility": "M",
        "image": null
      },
      "croatia/split-palace": {
        "name": "Diocletian Palace, Split",
        "description": "A Roman emperor retirement palace that is now the living old town of Split.",
        "details": "The palace is a maze of lanes, cafes, shops and homes built within the Roman walls. See the Peristyle, the cellars and the cathedral bell tower. The Riva promenade is the evening meeting place. Marjan Hill gives a view over the harbour.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "croatia/krka-trogir": {
        "name": "Krka waterfalls and Trogir",
        "description": "A smaller waterfall park with swimming at certain spots, and a medieval island town.",
        "details": "Krka National Park has walkways around the Skradinski Buk falls, with boat trips from Skradin. Swimming at the falls is restricted in some seasons, so check. Trogir is a UNESCO island town of stone lanes, about 30 minutes from Split.",
        "interests": [
          "outdoors",
          "culture",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "croatia/hvar-town": {
        "name": "Hvar Town and Spanjola fortress",
        "description": "A lively port with a Venetian loggia and a fortress above with views of the Pakleni Islands.",
        "details": "Hvar is known for lavender, nightlife and sunshine. The Spanjola fortress is a short climb above the town. The main square is one of the largest in Dalmatia. In summer the town is lively and expensive, so book ahead.",
        "interests": [
          "relax",
          "photography",
          "food"
        ],
        "mobility": "M",
        "image": null
      },
      "croatia/pakleni-islands": {
        "name": "Pakleni Islands boat trip",
        "description": "A chain of pine-covered islets with beach bars and swimming coves.",
        "details": "Water taxis run from the harbour to the islands in minutes, and boat tours include swims and a lunch on a beach. The water is clear and calm. Take sun protection, since shade is limited on some beaches.",
        "interests": [
          "relax",
          "outdoors",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "croatia/dubrovnik-walls": {
        "name": "Dubrovnik city walls and old town",
        "description": "A circuit on top of the medieval walls with views over red roofs and the Adriatic.",
        "details": "The walls are about two kilometres around and take two hours to walk. Go at opening or late afternoon to avoid the heat and crowds. Stradun is the main street, and the Rector Palace and the cathedral are inside. Cruise ship days are very crowded.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture"
        ],
        "mobility": "M",
        "image": null
      },
      "croatia/dubrovnik-cable-kayak": {
        "name": "Srd cable car and sea kayaking",
        "description": "A cable car view over the old town and a kayak paddle along the walls.",
        "details": "The cable car to Mount Srd gives a panorama at sunset. A guided sea kayak tour paddles under the walls to Lokrum Island and a swim in a cave. Both are good for a second day in the city.",
        "interests": [
          "adventure",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "croatia/zadar": {
        "name": "Zadar Sea Organ and sunset",
        "description": "A seafront instrument played by waves, and the Greeting to the Sun light circle.",
        "details": "Zadar has Roman ruins, a peninsula old town and a waterfront installation where the Sea Organ makes tones from the waves. The sunsets are famous. It is a short stop between Plitvice and Split.",
