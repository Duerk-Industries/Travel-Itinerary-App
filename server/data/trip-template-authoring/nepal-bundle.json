  "media": {
    "places": {
      "nepal/kathmandu-heritage": {
        "name": "Kathmandu Durbar Square, Swayambhunath and Boudhanath",
        "description": "The old royal square, the monkey temple and one of the largest stupas in the world.",
        "details": "Kathmandu Valley holds seven UNESCO monument zones. Durbar Square has temples damaged and restored after the 2015 earthquake, Swayambhunath is a hilltop stupa with macaques, and Boudhanath is a white dome ringed by prayer wheels, lively at dusk. Pashupatinath on the river is a Hindu cremation site, so visit respectfully.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "nepal/bhaktapur-patan": {
        "name": "Bhaktapur and Patan",
        "description": "Two medieval Newar cities of carved wooden temples, pottery squares and curd.",
        "details": "Bhaktapur has a car-free old town with pottery squares and the 55-window palace. Patan has the Golden Temple and a fine museum. Try juju dhau, the king of curds. Both are within an hour of Kathmandu and need an entry fee for foreigners.",
        "interests": [
          "culture",
          "authentic_local",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "nepal/nagarkot-sunrise": {
        "name": "Nagarkot sunrise",
        "description": "A hilltop village with views of the Himalaya from Langtang to Everest on clear mornings.",
        "details": "Nagarkot is 32 kilometres from Kathmandu and a classic overnight for sunrise. Views are best in October to March; haze and cloud are common in the monsoon. Short walks follow ridgelines through terraced fields.",
        "interests": [
          "photography",
          "outdoors",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "nepal/chitwan-safari": {
        "name": "Chitwan National Park jungle safari",
        "description": "Jeep safaris and canoe rides to spot one-horned rhinos, deer and crocodiles.",
        "details": "Chitwan is the lowland park on the Terai plains. Guided jeep safaris, river canoe trips and bird walks find one-horned rhinoceros, gharial and, with luck, tigers. Dawn and dusk are best. Walking inside the park is only with a guide.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "nepal/lumbini": {
        "name": "Lumbini birthplace of the Buddha",
        "description": "A UNESCO pilgrimage site with the Maya Devi Temple and monasteries from many countries.",
        "details": "Lumbini marks the birthplace of Siddhartha Gautama. The Maya Devi Temple stands over the exact spot, with a pond and an Ashoka pillar. A monastery zone has Buddhist temples built by many nations. Hire a bicycle or rickshaw, as the park is large and flat.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "nepal/pokhara-phewa": {
        "name": "Pokhara Phewa Lake and World Peace Pagoda",
        "description": "A lakeside town with boating, a white pagoda and a mountain view across the water.",
        "details": "Pokhara is the adventure hub of Nepal, with the Annapurna range reflected in Phewa Lake on clear mornings. Rowing boats cross to the Tal Barahi temple, and a hike climbs to the World Peace Pagoda. Paragliding and zip-lining are popular.",
        "interests": [
          "relax",
          "outdoors",
          "adventure",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "nepal/sarangkot": {
        "name": "Sarangkot sunrise and paragliding",
        "description": "A hill above Pokhara with an Annapurna sunrise view and a famous paragliding launch.",
        "details": "Sarangkot is reached by a pre-dawn taxi and offers views of Machapuchare and the Annapurna and Dhaulagiri ranges. Tandem paragliding flights launch from here. Flights depend on weather, and sunrise views are best from October to March.",
        "interests": [
          "adventure",
          "photography",
          "outdoors"
        ],
        "mobility": "M",
        "image": null
      },
      "nepal/poon-hill-trek": {
        "name": "Ghorepani Poon Hill trek",
        "description": "A short, classic Himalayan trek through rhododendron forest to a sunrise view of Dhaulagiri and Annapurna.",
        "details": "The trek from Nayapul climbs stone steps to Ghorepani at 2,800 metres, then 45 minutes before dawn to Poon Hill (3,210 metres) for a sweeping view of eight peaks. Teahouses provide food and beds. Permits are needed, and spring and autumn are best.",
        "interests": [
