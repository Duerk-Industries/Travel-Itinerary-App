      "united-states/nyc-landmarks": {
        "name": "Statue of Liberty, Times Square and the skyline",
        "description": "The harbour icon, the neon crossroads and views from a rooftop or observation deck.",
        "details": "New York icons include the Statue of Liberty and Ellis Island by ferry, Times Square at night, and the Empire State Building or Top of the Rock for skyline views. Book ferry and observation tickets ahead. Use the subway for most journeys.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/nyc-central-park-museums": {
        "name": "Central Park, the Met and Brooklyn Bridge",
        "description": "A giant park, a great art museum and a walk across a historic bridge.",
        "details": "Central Park has the Bethesda Fountain, Strawberry Fields and the Reservoir. The Metropolitan Museum of Art needs at least three hours. Walking the Brooklyn Bridge at sunrise or sunset gives skyline views, and DUMBO has a famous photo spot.",
        "interests": [
          "culture",
          "relax",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/nyc-food-broadway": {
        "name": "NYC food neighbourhoods and Broadway",
        "description": "Pizza, bagels and dumplings, then a Broadway show.",
        "details": "New York is a food city, from dollar pizza slices and bagels to dim sum in Chinatown and a food market at Chelsea. Broadway shows start at 7pm or 8pm, and discount tickets are sold at the TKTS booth in Times Square. Book major shows ahead.",
        "interests": [
          "food",
          "culture",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/dc-monuments": {
        "name": "National Mall, Lincoln Memorial and Smithsonian museums",
        "description": "Marble memorials and free world-class museums.",
        "details": "The National Mall has the Lincoln Memorial, Washington Monument and Capitol views. The Smithsonian museums, including Air and Space, Natural History and African American History, are free, though some need timed passes. The White House has no interior visits without advance arrangement.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/sf-golden-gate": {
        "name": "Golden Gate Bridge, Alcatraz and cable cars",
        "description": "The red suspension bridge, a prison island and the hilly streets of San Francisco.",
        "details": "The Golden Gate Bridge can be walked or biked, with views from Battery Spencer. Alcatraz tours need advance tickets, often weeks ahead. Cable cars run to Fisherman Wharf, and Lombard Street is the crooked street. Fog is common in summer, so bring a jacket.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "united-states/yosemite": {
        "name": "Yosemite Valley and Glacier Point",
        "description": "Granite cliffs, giant waterfalls and sequoia groves in the Sierra Nevada.",
        "details": "Yosemite has El Capitan, Half Dome and Yosemite Falls, which flow strongly in spring. Glacier Point and the Tioga Road close in winter. Entry may require a reservation in peak seasons. Mariposa Grove has giant sequoias.",
        "interests": [
          "outdoors",
          "adventure",
          "photography",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "united-states/la-hollywood-santa-monica": {
        "name": "Hollywood, Griffith Observatory and Santa Monica pier",
        "description": "The film capital sights, a hillside observatory and a beachfront pier.",
        "details": "In Los Angeles, the Hollywood Walk of Fame and TCL Chinese Theatre are touristy, but Griffith Observatory gives a view of the Hollywood sign and city. Santa Monica Pier and Venice Beach are the beach scene. LA is spread out, so plan around traffic.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "relax"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/las-vegas-strip": {
        "name": "Las Vegas Strip and Fremont Street",
        "description": "Themed casino hotels, fountains, shows and a downtown light canopy.",
        "details": "The Strip is best seen on foot at night, with the Bellagio fountains, the Venetian canals and shows by famous acts. Fremont Street downtown has a covered light display. Summer daytime heat is extreme. Book shows ahead.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "united-states/grand-canyon": {
        "name": "Grand Canyon South Rim",
        "description": "A mile-deep canyon seen from rim viewpoints and short trails.",
        "details": "The South Rim has viewpoints along Desert View Drive, the Rim Trail and Bright Angel Trail, where summer heat makes hiking below the rim dangerous. Sunrise and sunset are the best light. Reserve lodging far ahead. Free shuttles run along the rim.",
        "interests": [
          "iconic_landmarks",
