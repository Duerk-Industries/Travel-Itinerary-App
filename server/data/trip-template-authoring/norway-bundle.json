    "places": {
      "norway/oslo-opera-vigeland": {
        "name": "Oslo Opera House, Vigeland Park and the harbour",
        "description": "A marble opera house you can walk on, a sculpture park and the waterfront.",
        "details": "The Oslo Opera House has a sloping roof for walking, and the Aker Brygge waterfront has restaurants. Vigeland Park has more than 200 sculptures by Gustav Vigeland. The Fram and Viking Ship museums on Bygdoy are reached by ferry. Oslo is expensive, so take a city pass.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "norway/viking-fram": {
        "name": "Viking Ship Museum and Fram Museum",
        "description": "Original Viking ships and the polar vessel that reached both ends of the earth.",
        "details": "The Bygdoy peninsula has the Viking Ship Museum (closed for rebuilding in recent years, so check), the Fram Museum with the Arctic exploration ship, and the Kon-Tiki Museum. A ferry crosses from the city hall in summer. Allow three hours.",
        "interests": [
          "culture",
          "iconic_landmarks"
        ],
        "mobility": "L",
        "image": null
      },
      "norway/flam-railway": {
        "name": "Flam Railway and Naeroyfjord cruise",
        "description": "A steep scenic train down to the fjord, and a UNESCO fjord cruise.",
        "details": "The Flam Railway drops 866 metres over 20 kilometres with waterfalls and tunnels. Boat trips on the Naeroyfjord, a narrow UNESCO-listed arm of the Sognefjord, pass steep walls and villages. The Oslo-Bergen line connects at Myrdal, the Norway in a Nutshell route.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "outdoors"
        ],
        "mobility": "L",
        "image": null
      },
      "norway/bergen-bryggen": {
        "name": "Bergen Bryggen, Floibanen and fish market",
        "description": "The old Hanseatic wharf, a funicular above the city and a harbour fish market.",
        "details": "Bryggen is a UNESCO row of wooden buildings on the harbour. The Floibanen funicular climbs to a viewpoint above the city. Fresh seafood is sold at the fish market. Bergen is one of the wettest cities in Europe, so pack a rain jacket.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography",
          "food"
        ],
        "mobility": "L",
        "image": null
      },
      "norway/geirangerfjord": {
        "name": "Geirangerfjord, Trollstigen and Alesund",
        "description": "A cruise past waterfalls in a UNESCO fjord, and a steep mountain road.",
        "details": "The Geirangerfjord has the Seven Sisters waterfall, and cruises run from May to September. The Trollstigen mountain road has 11 hairpins, open from about June to October. Alesund is an Art Nouveau town on islands, with a viewpoint at Aksla.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "outdoors",
          "adventure"
        ],
        "mobility": "M",
        "image": null
      },
      "norway/tromso-arctic": {
        "name": "Tromso Arctic activities and northern lights",
        "description": "A northern city for aurora hunts, dog sledding, whale watching and Fjellheisen.",
        "details": "Tromso sits in the aurora oval, with northern lights seen from September to March on clear nights. Winter activities include dog sledding, reindeer visits and whale watching from November to January. In summer the midnight sun allows hikes at any hour. The Fjellheisen cable car gives city views.",
        "interests": [
          "adventure",
          "photography",
          "outdoors",
          "iconic_landmarks"
        ],
        "mobility": "M",
        "image": null
      },
      "norway/lofoten": {
        "name": "Lofoten Islands: Reine, Henningsvaer and Nusfjord",
        "description": "Jagged peaks rising from the sea, red fishing huts and some of the most photogenic villages.",
        "details": "The Lofoten road links fishing villages such as Reine, Hamnoy and Nusfjord, with beaches at Haukland and Uttakleiv. In winter you can see northern lights and in summer the midnight sun. A rental car is best, and the Reinebringen hike has steps and a big view. Book accommodation early.",
        "interests": [
          "photography",
          "outdoors",
          "adventure",
