      "malaysia/penang-hill": {
        "name": "Penang Hill and Kek Lok Si Temple",
        "description": "A funicular to a hilltop with city views, and a huge Buddhist temple complex.",
        "details": "Penang Hill is reached by a funicular railway, with views of George Town and the strait. Kek Lok Si is a vast hillside temple with a tall Guanyin statue. Go on a clear morning, and avoid midday heat.",
        "interests": [
          "iconic_landmarks",
          "photography",
          "culture"
        ],
        "mobility": "L",
        "image": null
      },
      "malaysia/langkawi-skybridge": {
        "name": "Langkawi SkyBridge and island hopping",
        "description": "A cable car to a curved bridge among clouds, and boat trips to mangroves and beaches.",
        "details": "The Langkawi SkyCab climbs Mount Mat Cincang to a curved pedestrian bridge. Mangrove tours see eagles and bats, and island-hopping visits Pregnancy Maiden Lake and beaches. Duty-free shopping is a draw. The cable car closes in strong wind or rain.",
