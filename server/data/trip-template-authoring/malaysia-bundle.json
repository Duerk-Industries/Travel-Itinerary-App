      "malaysia/sepilok-orangutan": {
        "name": "Sepilok Orangutan Rehabilitation Centre",
        "description": "A forest centre where young orangutans learn to live in the wild, with feeding platforms.",
        "details": "Sepilok cares for orphaned orangutans, with feeding times at 10am and 3pm viewed from platforms. The Rainforest Discovery Centre next door has a canopy walkway, and the sun bear sanctuary is close. It is near Sandakan, in eastern Sabah.",
