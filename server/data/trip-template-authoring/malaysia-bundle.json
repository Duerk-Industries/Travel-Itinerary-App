      "malaysia/george-town": {
        "name": "George Town street art and hawker food",
        "description": "A UNESCO old town of shophouses, murals, clan houses and some of the best street food in Asia.",
        "details": "George Town in Penang has heritage lanes, Khoo Kongsi clan house, Armenian Street murals and hawker centres serving char kway teow, assam laksa and cendol. Walk in the morning and eat at night. Penang Hill and Kek Lok Si temple lie just outside.",
        "interests": [
