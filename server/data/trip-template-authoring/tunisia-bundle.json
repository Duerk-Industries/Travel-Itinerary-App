          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "tunisia/tataouine-ksour": {
        "name": "Tataouine ksour and Chenini",
        "description": "Fortified granaries of the Berber south and a hilltop cave village.",
        "details": "The ksour of Ksar Ouled Soltane and the village of Chenini are in the hills near Tataouine. The ksour are multi-storey granaries, and Chenini has cave houses and a white mosque. Several Star Wars scenes were filmed nearby.",
