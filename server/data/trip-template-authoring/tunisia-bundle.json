      "tunisia/tunis-medina-bardo": {
        "name": "Tunis medina and the Bardo Museum",
        "description": "A UNESCO souk-filled old town and one of the greatest Roman mosaic collections.",
        "details": "The Tunis medina has covered souks, the Zitouna Mosque and rooftop cafes. The Bardo Museum holds an exceptional collection of Roman mosaics in a former palace. Go in the morning. Bargain gently in the souks.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
