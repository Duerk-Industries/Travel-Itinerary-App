      "tunisia/carthage-sidi-bou-said": {
        "name": "Carthage ruins and Sidi Bou Said",
        "description": "The ruins of the Phoenician and Roman city, and a blue-and-white clifftop village.",
        "details": "Carthage has the Antonine Baths, Punic ports and Roman villas scattered over suburbs. Sidi Bou Said is a village of whitewashed houses with blue doors and the Cafe des Nattes serving mint tea. A TGM light rail line connects them to Tunis.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "tunisia/dougga": {
        "name": "Dougga Roman city",
        "description": "A well-preserved Roman town on a hillside, a UNESCO site with a theatre and capitol.",
        "details": "Dougga is the best-preserved Roman town in North Africa, with a theatre, capitol temple and baths in a setting of olive groves. It is about two hours from Tunis, and a good stop on the way south.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "photography"
        ],
        "mobility": "M",
        "image": null
      },
      "tunisia/el-jem": {
        "name": "El Jem amphitheatre",
        "description": "A huge Roman amphitheatre, among the best preserved in the world, with room for 35,000.",
        "details": "The El Jem amphitheatre is the third largest in the Roman world and in excellent condition. You can walk the arena and underground passages. It is on the road between Kairouan and Djerba.",
        "interests": [
          "iconic_landmarks",
          "culture",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "tunisia/kairouan": {
        "name": "Kairouan Great Mosque and medina",
        "description": "Islam fourth holiest city, with the oldest mosque in North Africa and carpet workshops.",
        "details": "Kairouan has the Great Mosque of Uqba, a UNESCO site. Non-Muslims can enter the courtyard at certain times. The medina is known for carpets and the pastry makroudh. Dress modestly.",
        "interests": [
          "culture",
          "iconic_landmarks",
          "authentic_local"
        ],
        "mobility": "L",
        "image": null
      },
      "tunisia/matmata-troglodyte": {
        "name": "Matmata troglodyte houses",
        "description": "Underground homes dug into pits in the earth, and a Star Wars film location.",
        "details": "The troglodyte dwellings of Matmata are cool underground houses around courtyards. Hotel Sidi Driss was used in Star Wars. Some houses are open for tea and a tour. It is a stop on the road between Douz and Djerba.",
        "interests": [
          "culture",
          "authentic_local",
          "photography"
        ],
        "mobility": "L",
        "image": null
      },
      "tunisia/douz-sahara": {
        "name": "Douz and the Sahara camel trek",
        "description": "The gateway to the Sahara, with a camel ride into the dunes and a night in a desert camp.",
        "details": "Douz is a palm oasis town on the edge of the Grand Erg Oriental. Camel treks of an hour or overnight go into the dunes for sunset and a night in a Berber camp under stars. The Chott el Djerid salt lake lies on the road. Nights are cold in winter.",
        "interests": [
          "adventure",
          "outdoors",
          "photography",
          "authentic_local"
        ],
        "mobility": "M",
        "image": null
      },
      "tunisia/djerba": {
        "name": "Djerba Houmt Souk and El Ghriba synagogue",
        "description": "A Mediterranean island of white houses, beaches, a market and one of Africa oldest synagogues.",
        "details": "Djerba has the Houmt Souk market, Borj el Kebir fort and El Ghriba synagogue, still a pilgrimage site. The Guellala pottery village and the flamingo lagoon are other stops. Beaches line the north-east coast. Check current security guidance for the synagogue.",
        "interests": [
          "relax",
