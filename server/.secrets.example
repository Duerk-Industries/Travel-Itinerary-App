# This file is for storing secrets that will be uploaded to Google Secret Manager.
# The key is the secret name, and the value is the secret content.
#
# Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# SMTP_PASS="your-smtp-password"
#
# Deployment/IAM settings (used by scripts/setup-iam-permissions.sh):
# GCLOUD_PROJECT_ID="travel-itinerary-app-483623"
# GCLOUD_PROJECT_NUMBER="123456789012"
# DEPLOYER_SERVICE_ACCOUNT_EMAIL="github-action-1120278641@travel-itinerary-app-483623.iam.gserviceaccount.com"
# RUNTIME_SERVICE_ACCOUNT_EMAIL="123456789012-compute@developer.gserviceaccount.com"
# LOCATION_BUCKET="duerk-travel-itinerary-app-location-data"
