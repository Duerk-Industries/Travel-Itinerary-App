{
  "name": "app",
  "version": "0.1.0",
  "main": "AppEntry.js",
  "private": true,
  "scripts": {
    "test": "jest -c jest.config.js",
    "test:single": "jest -c jest.config.js",
    "test:shard": "jest -c jest.config.js --runInBand",
    "test:sharded": "node ../scripts/run-jest-shards.mjs --prefix . --script test:single --shards 4 -- --runInBand",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eas": "npx --yes eas-cli@20.2.0",
    "build:ios": "npx --yes eas-cli@20.2.0 build --platform ios --profile production",
    "build:ios:local": "npx --yes eas-cli@20.2.0 build --platform ios --profile production --local",
    "submit:ios": "npx --yes eas-cli@20.2.0 submit --platform ios --profile production",
    "export:web": "node ./scripts/export-web.js",
    "web": "node ./scripts/start-web.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "overrides": {
    "glob": "13.0.5",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8",
    "protobufjs": "7.6.5",
    "body-parser": "2.3.0",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "postcss": "8.5.23",
    "js-yaml": "4.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@sentry/react-native": "~7.2.0",
    "caniuse-lite": "^1.0.30001770",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-sharing": "~14.0.8",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.13.0",
    "pdfjs-dist": "^5.4.624",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/express": "^4.17.25",
    "@types/jest": "29.5.14",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.22",
    "@types/react": "~19.1.10",
    "@types/request": "^2.48.13",
    "@types/serve-static": "^1.15.10",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^2.0.16",
    "@types/tesseract.js": "^0.0.2",
    "express": "^5.2.1",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-test-renderer": "19.1.0",
    "supertest": "^6.3.4",
    "tesseract.js": "^7.0.0",
    "ts-jest": "^29.4.6"
  }
}
