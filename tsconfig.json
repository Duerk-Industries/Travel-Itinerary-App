{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "@playwright/test",
      "jest",
      "node"
    ]
  },
  "include": [
    "app/**/*.ts",
    "test-utils.ts"
  ],
  "extends": "expo/tsconfig.base"
}
